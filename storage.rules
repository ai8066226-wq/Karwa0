rules_version = '2';
service firebase.storage { match /b/{bucket}/o {
 function signed(){return request.auth!=null;}
 function admin(){return signed()&&firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role=='admin';}
 function serviceOwner(uid){return signed()&&request.auth.uid==uid&&firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role=='serviceProvider';}
 match /driver-documents/{uid}/{file}{allow read:if signed()&&(request.auth.uid==uid||admin());allow write:if signed()&&request.auth.uid==uid&&request.resource.size<5*1024*1024&&request.resource.contentType.matches('image/.*|application/pdf');}
 match /service-media/{uid}/{kind}/{file}{
   allow read: if signed();
   allow create, update: if serviceOwner(uid) && (kind=='cover'||kind=='items') && request.resource.size<=50*1024 && request.resource.contentType=='image/webp';
   allow delete: if serviceOwner(uid)||admin();
 }
}}
