     && request.resource.data.tripOtp.matches('^[0-9]{4}$')
     && getAfter(/databases/$(database)/documents/orders/$(id)).data.userId==request.auth.uid;
   allow update,delete:if false;
 }
 match /appSettings/{id}{allow read:if true;allow create,update,delete:if admin();}
 match /topupRequests/{id}{
   function validAccountType(){return (role()=='customer'&&request.resource.data.accountType=='customer')||((role()=='driver'||role()=='driverApplicant')&&request.resource.data.accountType=='captain')||((role()=='serviceProvider'||role()=='serviceApplicant')&&request.resource.data.accountType=='service');}
   function ownsMatchingTopupLock(){return getAfter(/databases/$(database)/documents/topupLocks/$(request.auth.uid)).data.get('requestId','')==id&&getAfter(/databases/$(database)/documents/topupLocks/$(request.auth.uid)).data.get('status','')=='pending';}
   allow create:if signed()
     && validAccountType()
     && request.resource.data.keys().hasOnly(['userId','customerName','email','amount','transferReference','method','accountType','accountRole','status','createdAt','updatedAt'])
     && request.resource.data.userId==request.auth.uid
     && request.resource.data.customerName is string && request.resource.data.customerName.size()<=80
     && request.resource.data.email is string && request.resource.data.email.size()<=160
     && request.resource.data.amount is number && request.resource.data.amount>=1000 && request.resource.data.amount<=1000000
     && request.resource.data.transferReference is string && request.resource.data.transferReference.size()>=3 && request.resource.data.transferReference.size()<=80
     && request.resource.data.accountRole==role()
     && request.resource.data.method=='mastercard_local'
     && request.resource.data.status=='pending'
     && ownsMatchingTopupLock();
   allow read:if admin()||(signed()&&resource.data.userId==request.auth.uid);
   allow update,delete:if admin();
 }
 match /topupLocks/{uid}{
   allow read:if admin()||own(uid);
   allow create:if own(uid)
     && !exists(/databases/$(database)/documents/topupLocks/$(uid))
     && request.resource.data.keys().hasOnly(['userId','requestId','status','createdAt','updatedAt'])
     && request.resource.data.userId==uid
     && request.resource.data.requestId is string && request.resource.data.requestId.size()>0
     && request.resource.data.status=='pending'
