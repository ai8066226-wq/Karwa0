rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function signed(){return request.auth!=null;}
 function own(id){return signed()&&request.auth.uid==id;}
 function userDoc(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
 function userExists(){return signed()&&exists(/databases/$(database)/documents/users/$(request.auth.uid));}
 function role(){return userExists()?userDoc().get('role',null):null;}
 function admin(){return signed()&&role()=='admin';}
 function driver(){return signed()&&role()=='driver';}
 function customer(){return signed()&&role()=='customer';}
 function serviceApplicant(){return signed()&&role()=='serviceApplicant';}
 function serviceProvider(){return signed()&&role()=='serviceProvider';}
 function validServiceCategory(value){return value in ['restaurant','grocery','retail','maintenance','home','health','other'];}
 match /users/{uid}{
   allow create:if own(uid)&&(request.resource.data.role=='customer'||request.resource.data.role=='driverApplicant'||request.resource.data.role=='serviceApplicant');
   allow read:if own(uid)||admin();
   allow update:if admin()||(own(uid)&&(
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','notifications','savedAddresses','balance','updatedAt'])
     || (!resource.data.keys().hasAny(['role'])
       && request.resource.data.role=='customer'
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','email','updatedAt']))
   ));
   allow delete:if admin();
   match /pushTokens/{id}{allow read:if own(uid)||admin();allow write:if own(uid);}
 }
 match /driverApplications/{uid}{allow create:if own(uid)&&request.resource.data.userId==request.auth.uid&&request.resource.data.status=='pending';allow read:if own(uid)||admin();allow update:if admin()||(own(uid)&&resource.data.status!='approved'&&request.resource.data.userId==request.auth.uid&&request.resource.data.status=='pending'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','phone','serviceType','vehicleType','vehicleMake','vehicleModel','vehicleCondition','plate','city','status','submittedAt','updatedAt']));allow delete:if admin();}
 match /drivers/{uid}{
   allow read:if admin()||driver()||own(uid);
   allow create,delete:if admin();
   allow update:if admin()||(own(uid)&&driver()&&(
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online','latitude','longitude','locationAccuracy','locationUpdatedAt','updatedAt'])
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeOrderId','activeOrderCode','busySince','updatedAt'])&&(
       (resource.data.get('activeOrderId','')==''
         && request.resource.data.activeOrderId is string
         && request.resource.data.activeOrderId.size()>0
         && request.resource.data.activeOrderCode is string
         && request.resource.data.busySince is timestamp
         && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.activeOrderId)).data.driverId==uid
         && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.activeOrderId)).data.cancelled==false
         && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.activeOrderId)).data.statusIndex<4)
       || (resource.data.get('activeOrderId','')!=''
         && request.resource.data.activeOrderId==''
         && request.resource.data.activeOrderCode==''
         && request.resource.data.busySince==null
         && (getAfter(/databases/$(database)/documents/orders/$(resource.data.activeOrderId)).data.cancelled==true
           || getAfter(/databases/$(database)/documents/orders/$(resource.data.activeOrderId)).data.statusIndex>=4))
     ))
   ));
 }
 match /publicDrivers/{uid}{
   function privateDriver(){return get(/databases/$(database)/documents/drivers/$(uid)).data;}
   allow read:if signed();
   allow create,update:if own(uid)&&driver()
     && exists(/databases/$(database)/documents/drivers/$(uid))
     && privateDriver().get('blocked',false)!=true
     && request.resource.data.keys().hasOnly(['driverId','name','vehicleType','online','latitude','longitude','locationAccuracy','locationUpdatedAt','updatedAt'])
     && request.resource.data.driverId==uid
     && request.resource.data.name is string
     && request.resource.data.name==userDoc().get('name','')
     && request.resource.data.name.size()>=2
     && request.resource.data.name.size()<=80
     && request.resource.data.vehicleType is string
     && request.resource.data.vehicleType==privateDriver().get('vehicleType','مركبة')
     && request.resource.data.online==true
     && request.resource.data.latitude is number
     && request.resource.data.latitude>=-90
     && request.resource.data.latitude<=90
     && request.resource.data.longitude is number
     && request.resource.data.longitude>=-180
     && request.resource.data.longitude<=180
     && request.resource.data.locationAccuracy is number
     && request.resource.data.locationAccuracy>=0
     && request.resource.data.locationUpdatedAt is timestamp
     && request.resource.data.updatedAt is timestamp;
   allow delete:if admin()||(own(uid)&&driver());
 }
 match /orders/{id}{
   allow read:if signed()&&(resource.data.userId==request.auth.uid||resource.data.driverId==request.auth.uid||driver()||admin());
   allow create:if admin()||(customer()&&request.resource.data.userId==request.auth.uid&&request.resource.data.driverId==null&&request.resource.data.statusIndex==0&&request.resource.data.cancelled==false);
   allow update:if admin()
     || (customer()&&resource.data.userId==request.auth.uid&&resource.data.cancelled==false&&request.resource.data.cancelled==true&&request.resource.data.cancelledBy=='customer'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled','cancellationReason','cancelledBy','cancelledAt','updatedAt']))
     || (driver() && (
       (resource.data.driverId==null && resource.data.cancelled==false && resource.data.statusIndex==0 && request.resource.data.driverId==request.auth.uid && request.resource.data.statusIndex==resource.data.statusIndex && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverId','driverName','driverPhone','assignmentStatus','acceptedAt','updatedAt']) && (resource.data.type!='ride' || (get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.get('serviceType','taxi')=='taxi' && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.vehicleType!='دراجة')) && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.get('activeOrderId','')=='' && getAfter(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.activeOrderId==id)
       || (resource.data.driverId==request.auth.uid && request.resource.data.driverId==request.auth.uid && request.resource.data.statusIndex==resource.data.statusIndex+1 && request.resource.data.statusIndex<=4 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusIndex','arrivedAt','startedAt','completedAt','paymentStatus','updatedAt']))
       || (resource.data.driverId==request.auth.uid && request.resource.data.driverId==request.auth.uid && resource.data.cancelled==false && request.resource.data.cancelled==true && request.resource.data.cancelledBy=='driver' && request.resource.data.statusIndex==resource.data.statusIndex && resource.data.statusIndex<4 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled','cancelledBy','cancellationReason','cancelledAt','assignmentStatus','updatedAt']))
     ));
   allow delete:if admin();
   match /tracking/{tid}{function o(){return get(/databases/$(database)/documents/orders/$(id)).data;}allow read:if signed()&&(o().userId==request.auth.uid||o().driverId==request.auth.uid||admin());allow create,update:if driver()&&o().driverId==request.auth.uid&&request.resource.data.driverId==request.auth.uid;allow delete:if admin();}
 }
 match /orderSecrets/{id}{
   allow read:if admin()||(signed()&&resource.data.userId==request.auth.uid);
   allow create:if customer()
     && request.resource.data.userId==request.auth.uid
     && request.resource.data.keys().hasOnly(['userId','tripOtp','createdAt'])
     && request.resource.data.tripOtp is string
     && request.resource.data.tripOtp.matches('^[0-9]{4}$')
     && getAfter(/databases/$(database)/documents/orders/$(id)).data.userId==request.auth.uid;
   allow update,delete:if false;
 }
 match /supportTickets/{id}{allow create:if signed()&&request.resource.data.userId==request.auth.uid;allow read:if signed()&&(resource.data.userId==request.auth.uid||admin());allow update:if admin();allow delete:if admin();}
 match /coupons/{id}{allow read:if signed();allow write:if admin();}
 match /walletTransactions/{id}{allow read:if signed()&&(resource.data.driverId==request.auth.uid||admin());allow write:if false;}
 match /auditLogs/{id}{allow read:if admin();allow write:if false;}
 match /notificationQueue/{id}{allow read:if admin();allow write:if false;}
 match /authChallenges/{id}{allow read,write:if false;}
 match /authRateLimits/{id}{allow read,write:if false;}
 match /safetyEvents/{id}{allow read:if admin()||(signed()&&(resource.data.reportedBy==request.auth.uid));allow write:if false;}

 match /serviceApplications/{uid}{
   function validApplication(data){return data.userId==uid
     && data.ownerName is string && data.ownerName.size()>=2 && data.ownerName.size()<=80
     && data.businessName is string && data.businessName.size()>=2 && data.businessName.size()<=80
     && validServiceCategory(data.category)
     && data.phone is string && data.phone.size()>=8 && data.phone.size()<=20
     && data.email is string && data.email.size()>=3 && data.email.size()<=160
     && data.city is string && data.city.size()>=2 && data.city.size()<=50
     && data.address is string && data.address.size()>=3 && data.address.size()<=160
     && data.location is map
     && data.location.latitude is number && data.location.latitude>=-90 && data.location.latitude<=90
     && data.location.longitude is number && data.location.longitude>=-180 && data.location.longitude<=180
     && data.get('description','') is string && data.get('description','').size()<=500
     && data.serviceType=='other';}
   allow create:if own(uid)
     && getAfter(/databases/$(database)/documents/users/$(uid)).data.get('role',null)=='serviceApplicant'
     && request.resource.data.status=='pending'
     && validApplication(request.resource.data)
     && request.resource.data.keys().hasOnly(['userId','ownerName','businessName','category','serviceType','phone','email','city','address','location','description','status','reviewNote','submittedAt','updatedAt']);
   allow read:if own(uid)||admin();
   allow update:if admin()||(own(uid)
     && serviceApplicant()
     && resource.data.status!='approved'
     && request.resource.data.status=='pending'
     && validApplication(request.resource.data)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName','businessName','category','phone','email','city','address','location','description','status','reviewNote','resubmittedAt','updatedAt']));
   allow delete:if admin();
 }

 match /serviceProfiles/{uid}{
   function validProfile(data){return data.ownerId==uid
     && data.businessName is string && data.businessName.size()>=2 && data.businessName.size()<=80
     && validServiceCategory(data.category)
     && data.phone is string && data.phone.size()>=8 && data.phone.size()<=20
     && data.city is string && data.city.size()<=50
     && data.address is string && data.address.size()>=3 && data.address.size()<=160
     && data.location is map
     && data.location.latitude is number && data.location.latitude>=-90 && data.location.latitude<=90
     && data.location.longitude is number && data.location.longitude>=-180 && data.location.longitude<=180
     && data.get('description','') is string && data.get('description','').size()<=500
     && data.get('items',[]) is list && data.get('items',[]).size()<=50
     && data.active is bool
     && data.approvalStatus=='approved';}
   allow read:if admin()||own(uid)||(signed()&&resource.data.active==true&&resource.data.approvalStatus=='approved');
   allow create:if admin()||(own(uid)&&serviceProvider()&&validProfile(request.resource.data));
   allow update:if admin()||(own(uid)
     && serviceProvider()
     && validProfile(request.resource.data)
     && request.resource.data.ownerId==resource.data.ownerId
     && request.resource.data.category==resource.data.category
     && request.resource.data.approvalStatus==resource.data.approvalStatus
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['businessName','phone','city','address','description','location','items','active','updatedAt']));
   allow delete:if admin();
 }

 match /serviceRequests/{id}{
   function providerProfile(){return get(/databases/$(database)/documents/serviceProfiles/$(request.resource.data.providerId)).data;}
   allow create:if customer()
     && request.resource.data.customerId==request.auth.uid
     && request.resource.data.customerName==userDoc().get('name','')
     && request.resource.data.providerId is string
     && request.resource.data.providerId.size()>0
     && providerProfile().active==true
     && providerProfile().approvalStatus=='approved'
     && request.resource.data.providerName==providerProfile().businessName
     && request.resource.data.providerAddress==providerProfile().address
     && request.resource.data.status=='pending'
     && request.resource.data.itemName is string && request.resource.data.itemName.size()>=2 && request.resource.data.itemName.size()<=80
     && request.resource.data.requestText is string && request.resource.data.requestText.size()>=3 && request.resource.data.requestText.size()<=500
     && request.resource.data.customerAddress is string && request.resource.data.customerAddress.size()>=3 && request.resource.data.customerAddress.size()<=180
     && request.resource.data.keys().hasOnly(['customerId','customerName','providerId','providerName','providerCategory','providerAddress','providerLocation','itemName','itemPrice','requestText','customerAddress','customerLocation','status','createdAt','updatedAt']);
   allow read:if admin()||(customer()&&resource.data.customerId==request.auth.uid)||(serviceProvider()&&resource.data.providerId==request.auth.uid);
   allow update:if admin()
     || (customer()&&resource.data.customerId==request.auth.uid&&resource.data.status=='pending'&&request.resource.data.status=='cancelled'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','updatedAt']))
     || (serviceProvider()
       && resource.data.providerId==request.auth.uid
       && request.resource.data.providerId==request.auth.uid
       && ((resource.data.status=='pending'&&request.resource.data.status in ['accepted','rejected'])||(resource.data.status=='accepted'&&request.resource.data.status=='completed'))
       && request.resource.data.get('providerNote','') is string
       && request.resource.data.get('providerNote','').size()<=300
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','providerNote','statusUpdatedAt','updatedAt']));
   allow delete:if admin();
 }

 match /restaurants/{id}{
   allow read:if admin() || own(id) || (signed() && resource.data.ownerId==request.auth.uid) || (signed() && resource.data.active==true);
   allow create:if admin() || (signed()
     && request.resource.data.ownerId==request.auth.uid
     && serviceProvider()
     && getAfter(/databases/$(database)/documents/serviceProfiles/$(request.auth.uid)).data.get('category','')=='restaurant'
     && getAfter(/databases/$(database)/documents/serviceProfiles/$(request.auth.uid)).data.get('approvalStatus','')=='approved'
     && request.resource.data.active is bool
     && request.resource.data.approvalStatus=='approved'
     && request.resource.data.name is string && request.resource.data.name.size()>=2 && request.resource.data.name.size()<=80
     && request.resource.data.address is string && request.resource.data.address.size()>=3 && request.resource.data.address.size()<=160
     && request.resource.data.phone is string && request.resource.data.phone.size()>=8 && request.resource.data.phone.size()<=20
     && request.resource.data.location is map
     && request.resource.data.location.latitude is number && request.resource.data.location.latitude>=-90 && request.resource.data.location.latitude<=90
     && request.resource.data.location.longitude is number && request.resource.data.location.longitude>=-180 && request.resource.data.location.longitude<=180
     && request.resource.data.meals is list && request.resource.data.meals.size()>0 && request.resource.data.meals.size()<=50);
   allow update:if admin() || (signed()
     && resource.data.ownerId==request.auth.uid
     && request.resource.data.ownerId==request.auth.uid
     && serviceProvider()
     && get(/databases/$(database)/documents/serviceProfiles/$(request.auth.uid)).data.get('category','')=='restaurant'
     && get(/databases/$(database)/documents/serviceProfiles/$(request.auth.uid)).data.get('approvalStatus','')=='approved'
     && request.resource.data.approvalStatus==resource.data.approvalStatus
     && request.resource.data.name is string && request.resource.data.name.size()>=2 && request.resource.data.name.size()<=80
     && request.resource.data.address is string && request.resource.data.address.size()>=3 && request.resource.data.address.size()<=160
     && request.resource.data.phone is string && request.resource.data.phone.size()>=8 && request.resource.data.phone.size()<=20
     && request.resource.data.location is map
     && request.resource.data.location.latitude is number && request.resource.data.location.latitude>=-90 && request.resource.data.location.latitude<=90
     && request.resource.data.location.longitude is number && request.resource.data.location.longitude>=-180 && request.resource.data.location.longitude<=180
     && request.resource.data.meals is list && request.resource.data.meals.size()>0 && request.resource.data.meals.size()<=50
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','address','phone','location','meals','active','updatedAt']));
   allow delete:if admin();
 }
 match /roadReports/{id}{
   allow read:if signed();
   allow create:if driver()&&request.resource.data.reportedBy==request.auth.uid;
   allow update:if driver();
   allow delete:if admin();
 }
 match /landmarks/{id}{
   allow read:if signed();
   allow create:if signed()&&request.resource.data.createdBy==request.auth.uid;
   allow update,delete:if admin()||(signed()&&resource.data.createdBy==request.auth.uid);
 }
 match /tripShares/{id}{allow read,write:if false;}
 match /customerRatings/{id}{allow read:if admin()||(signed()&&(resource.data.customerId==request.auth.uid||resource.data.driverId==request.auth.uid));allow write:if false;}
 match /ratings/{id}{function o(){return get(/databases/$(database)/documents/orders/$(id)).data;}allow create:if signed()&&o().userId==request.auth.uid&&o().statusIndex>=4&&request.resource.data.customerId==request.auth.uid;allow read:if signed()&&(resource.data.customerId==request.auth.uid||resource.data.driverId==request.auth.uid||admin());allow update:if false;allow delete:if admin();}
}}
