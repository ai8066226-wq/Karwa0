     && request.resource.data.phone is string && request.resource.data.phone.size()>=8 && request.resource.data.phone.size()<=20
     && request.resource.data.location is map
     && request.resource.data.location.latitude is number && request.resource.data.location.latitude>=-90 && request.resource.data.location.latitude<=90
     && request.resource.data.location.longitude is number && request.resource.data.location.longitude>=-180 && request.resource.data.location.longitude<=180
     && request.resource.data.meals is list && request.resource.data.meals.size()>0 && request.resource.data.meals.size()<=50);
   allow update:if admin() || (signed()
     && resource.data.ownerId==request.auth.uid
     && request.resource.data.ownerId==request.auth.uid
     && serviceProvider()
     && get(/databases/$(database)/documents/serviceProfiles/$(request.auth.uid)).data.get('category','')=='restaurant'
     && get(/databases/$(database)/documents/serviceProfiles/$(request.auth.uid)).data.get('approvalStatus','')=='approved'
     && request.resource.data.approvalStatus==resource.data.approvalStatus
     && request.resource.data.name is string && request.resource.data.name.size()>=2 && request.resource.data.name.size()<=80
     && request.resource.data.address is string && request.resource.data.address.size()>=3 && request.resource.data.address.size()<=160
     && request.resource.data.phone is string && request.resource.data.phone.size()>=8 && request.resource.data.phone.size()<=20
     && request.resource.data.location is map
     && request.resource.data.location.latitude is number && request.resource.data.location.latitude>=-90 && request.resource.data.location.latitude<=90
     && request.resource.data.location.longitude is number && request.resource.data.location.longitude>=-180 && request.resource.data.location.longitude<=180
     && request.resource.data.meals is list && request.resource.data.meals.size()>0 && request.resource.data.meals.size()<=50
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','address','phone','location','meals','coverImageUrl','coverImagePath','coverImageBytes','active','updatedAt']));
   allow delete:if admin();
 }
 match /roadReports/{id}{
   function verificationAfter(){return getAfter(/databases/$(database)/documents/roadReportVerifications/$(request.resource.data.lastVerificationId)).data;}
   function hasFreshVerification(answer){return request.resource.data.lastVerificationId is string
     && existsAfter(/databases/$(database)/documents/roadReportVerifications/$(request.resource.data.lastVerificationId))
     && verificationAfter().reportId==id
     && verificationAfter().driverId==request.auth.uid
     && verificationAfter().answer==answer
     && verificationAfter().round==resource.data.get('verificationRound',0);}
   function commonVerificationFields(answer){return resource.data.active==true
     && driverNearRoadReport(resource.data)
     && hasFreshVerification(answer)
     && request.resource.data.lastVerifiedBy==request.auth.uid
     && request.resource.data.lastVerificationResult==(answer=='yes'?'present':'absent')
     && request.resource.data.lastVerifiedAt==request.time
     && request.resource.data.updatedAt==request.time;}
   function validPresentVerification(){return commonVerificationFields('yes')
     && !(resource.data.get('lastVerificationResult','')=='present'&&resource.data.get('lastVerifiedBy','')==request.auth.uid)
     && request.resource.data.active==true
     && request.resource.data.confirmations==resource.data.get('confirmations',0)+1
     && request.resource.data.absenceVoteCount==0
     && request.resource.data.firstAbsentBy==''
     && request.resource.data.firstAbsentAt==null
     && request.resource.data.verificationRound==resource.data.get('verificationRound',0)+1
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmations','absenceVoteCount','firstAbsentBy','firstAbsentAt','verificationRound','lastVerificationId','lastVerificationResult','lastVerifiedBy','lastVerifiedAt','updatedAt']);}
   function validFirstAbsentVerification(){return commonVerificationFields('no')
     && !(resource.data.get('lastVerificationResult','')=='present'&&resource.data.get('lastVerifiedBy','')==request.auth.uid)
     && resource.data.get('firstAbsentBy','')==''
     && request.resource.data.active==true
     && request.resource.data.confirmations==resource.data.get('confirmations',0)
     && request.resource.data.absenceVoteCount==1
     && request.resource.data.firstAbsentBy==request.auth.uid
     && request.resource.data.firstAbsentAt==request.time
     && request.resource.data.verificationRound==resource.data.get('verificationRound',0)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['absenceVoteCount','firstAbsentBy','firstAbsentAt','verificationRound','lastVerificationId','lastVerificationResult','lastVerifiedBy','lastVerifiedAt','updatedAt']);}
   function validSecondAbsentVerification(){return commonVerificationFields('no')
     && resource.data.get('absenceVoteCount',0)==1
     && resource.data.get('firstAbsentBy','') is string
     && resource.data.get('firstAbsentBy','')!=''
     && resource.data.firstAbsentBy!=request.auth.uid
     && request.resource.data.active==false
     && request.resource.data.confirmations==resource.data.get('confirmations',0)
     && request.resource.data.absenceVoteCount==2
     && request.resource.data.firstAbsentBy==resource.data.firstAbsentBy
     && request.resource.data.removedBySecond==request.auth.uid
     && request.resource.data.removedReason=='two_distinct_drivers_confirmed_absent'
     && request.resource.data.removedAt==request.time
     && request.resource.data.verificationRound==resource.data.get('verificationRound',0)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','absenceVoteCount','removedBySecond','removedReason','removedAt','verificationRound','lastVerificationId','lastVerificationResult','lastVerifiedBy','lastVerifiedAt','updatedAt']);}
   allow read:if signed();
   allow create:if driver()
     && request.resource.data.reportedBy==request.auth.uid
     && request.resource.data.type in ['traffic','accident','closure','roadwork','hazard']
     && request.resource.data.latitude is number && request.resource.data.latitude>=-90 && request.resource.data.latitude<=90
     && request.resource.data.longitude is number && request.resource.data.longitude>=-180 && request.resource.data.longitude<=180
     && request.resource.data.active==true
     && request.resource.data.get('absenceVoteCount',0)==0
     && request.resource.data.get('firstAbsentBy','')==''
     && request.resource.data.get('verificationRound',0)==0;
   allow update:if admin()||(driver()&&(validPresentVerification()||validFirstAbsentVerification()||validSecondAbsentVerification()));
   allow delete:if admin();
 }
 match /roadReportVerifications/{id}{
   function reportBefore(){return get(/databases/$(database)/documents/roadReports/$(request.resource.data.reportId)).data;}
   function validVerificationData(){let d=roadDriverDoc();return request.resource.data.keys().hasOnly(['reportId','driverId','answer','round','driverLatitude','driverLongitude','locationAccuracy','verifiedAt'])
     && request.resource.data.reportId is string && request.resource.data.reportId.size()>0
     && request.resource.data.driverId==request.auth.uid
     && request.resource.data.answer in ['yes','no']
     && request.resource.data.round is int && request.resource.data.round>=0
     && request.resource.data.verifiedAt==request.time
     && request.resource.data.driverLatitude==d.latitude
     && request.resource.data.driverLongitude==d.longitude
     && request.resource.data.locationAccuracy==d.get('locationAccuracy',0)
     && exists(/databases/$(database)/documents/roadReports/$(request.resource.data.reportId))
     && reportBefore().active==true
     && request.resource.data.round==reportBefore().get('verificationRound',0)
     && driverNearRoadReport(reportBefore());}
   allow read:if admin()||(driver()&&resource.data.driverId==request.auth.uid);
   allow create:if driver()&&validVerificationData();
   allow update:if driver()&&resource.data.driverId==request.auth.uid
     && request.resource.data.driverId==resource.data.driverId
     && request.resource.data.reportId==resource.data.reportId
     && request.resource.data.round>resource.data.round
     && validVerificationData();
   allow delete:if admin();
 }
 match /roadReportArchive/{id}{allow read:if admin();allow write:if false;}

 match /landmarks/{id}{
   allow read:if signed();
   allow create:if signed()&&request.resource.data.createdBy==request.auth.uid;
   allow update,delete:if admin()||(signed()&&resource.data.createdBy==request.auth.uid);
 }
 match /tripShares/{id}{
   function sharedOrder(){return get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data;}
   allow create:if customer()
     && request.resource.data.keys().hasOnly(['token','orderId','customerId','createdAt','expiresAtMs'])
     && request.resource.data.token==id
     && request.resource.data.customerId==request.auth.uid
     && request.resource.data.createdAt==request.time
     && request.resource.data.expiresAtMs is int
     && sharedOrder().userId==request.auth.uid;
   allow read:if admin()||(signed()&&resource.data.customerId==request.auth.uid);
   allow update:if false;
   allow delete:if admin()||(signed()&&resource.data.customerId==request.auth.uid);
 }
 match /customerRatings/{id}{
   function ratedOrder(){return get(/databases/$(database)/documents/orders/$(id)).data;}
   allow read:if admin()||(signed()&&(resource.data.customerId==request.auth.uid||resource.data.driverId==request.auth.uid));
   allow create:if driver()
     && request.resource.data.keys().hasOnly(['orderId','customerId','driverId','score','createdAt'])
     && request.resource.data.orderId==id
     && request.resource.data.driverId==request.auth.uid
     && request.resource.data.customerId==ratedOrder().userId
     && ratedOrder().driverId==request.auth.uid
     && ratedOrder().get('cancelled',false)==false
     && ratedOrder().statusIndex>=4
     && request.resource.data.score is int && request.resource.data.score>=1 && request.resource.data.score<=5
     && request.resource.data.createdAt==request.time;
   allow update:if false;
   allow delete:if admin();
 }
 match /ratings/{id}{
   function orderForRating(){return get(/databases/$(database)/documents/orders/$(request.resource.data.referenceId)).data;}
   function serviceForRating(){return get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.referenceId)).data;}
   function baseRatingValid(){return customer()
     && request.resource.data.customerId==request.auth.uid
     && request.resource.data.score is int
     && request.resource.data.score>=1 && request.resource.data.score<=5
     && request.resource.data.comment is string && request.resource.data.comment.size()<=300
     && request.resource.data.tags is list && request.resource.data.tags.size()<=4
     && request.resource.data.targetName is string && request.resource.data.targetName.size()>=1 && request.resource.data.targetName.size()<=100
     && request.resource.data.customerName is string && request.resource.data.customerName.size()>=1 && request.resource.data.customerName.size()<=100
     && request.resource.data.createdAt==request.time
     && request.resource.data.referenceId==id;}
   function validLegacyOrderRating(){let o=get(/databases/$(database)/documents/orders/$(id)).data;return customer()
     && o.userId==request.auth.uid && o.get('cancelled',false)==false && o.statusIndex>=4
     && o.driverId is string && o.driverId.size()>0
     && request.resource.data.customerId==request.auth.uid
     && request.resource.data.orderId==id
     && request.resource.data.driverId==o.driverId
     && request.resource.data.score is int && request.resource.data.score>=1 && request.resource.data.score<=5
     && request.resource.data.comment is string && request.resource.data.comment.size()<=300
     && request.resource.data.createdAt==request.time
     && request.resource.data.keys().hasOnly(['orderId','orderCode','customerId','driverId','driverName','score','comment','createdAt']);}
   function validOrderRating(){let o=orderForRating();return baseRatingValid()
     && request.resource.data.referenceType=='order'
     && request.resource.data.targetType=='driver'
     && request.resource.data.orderId==id
     && request.resource.data.driverId==o.driverId
     && request.resource.data.targetId==o.driverId
     && o.userId==request.auth.uid
     && o.get('cancelled',false)==false
     && o.statusIndex>=4
     && o.driverId is string && o.driverId.size()>0
     && ((o.type=='ride'&&request.resource.data.ratingType=='taxi')||(o.type in ['parcel','food','serviceDelivery']&&request.resource.data.ratingType=='delivery'))
     && request.resource.data.keys().hasOnly(['ratingType','targetType','targetId','targetName','referenceType','referenceId','referenceCode','customerId','customerName','score','comment','tags','createdAt','orderId','orderCode','driverId','driverName']);}
   function validServiceRating(){let s=serviceForRating();return baseRatingValid()
     && request.resource.data.referenceType=='serviceRequest'
     && request.resource.data.ratingType=='service'
     && request.resource.data.targetType=='provider'
     && request.resource.data.serviceRequestId==id
     && request.resource.data.providerId==s.providerId
     && request.resource.data.targetId==s.providerId
     && request.resource.data.providerCategory==s.providerCategory
     && request.resource.data.itemName==s.itemName
     && s.customerId==request.auth.uid
     && s.status=='completed'
     && s.providerId is string && s.providerId.size()>0
     && request.resource.data.keys().hasOnly(['ratingType','targetType','targetId','targetName','referenceType','referenceId','referenceCode','customerId','customerName','score','comment','tags','createdAt','serviceRequestId','providerId','providerName','providerCategory','itemName']);}
   allow create:if validOrderRating()||validServiceRating()||validLegacyOrderRating();
   allow read:if admin()||(signed()&&resource.data.customerId==request.auth.uid)||(driver()&&(resource.data.get('driverId','')==request.auth.uid||(resource.data.get('targetType','')=='driver'&&resource.data.get('targetId','')==request.auth.uid)))||(serviceProvider()&&(resource.data.get('providerId','')==request.auth.uid||(resource.data.get('targetType','')=='provider'&&resource.data.get('targetId','')==request.auth.uid)));
   allow update:if false;
   allow delete:if admin();
 }
}}
