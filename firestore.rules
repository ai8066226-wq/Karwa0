rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function signed(){return request.auth!=null;}
 function own(id){return signed()&&request.auth.uid==id;}
 function userDoc(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
 function userExists(){return signed()&&exists(/databases/$(database)/documents/users/$(request.auth.uid));}
 function role(){return userExists()&&userDoc().get('disabled',false)!=true?userDoc().get('role',null):null;}
 function admin(){return signed()&&role()=='admin';}
 function driver(){return signed()&&role()=='driver';}
 function customer(){return signed()&&role()=='customer';}
 function serviceApplicant(){return signed()&&role()=='serviceApplicant';}
 function serviceProvider(){return signed()&&role()=='serviceProvider';}
 function validServiceCategory(value){return value in ['restaurant','grocery','retail','maintenance','home','health','other'];}
 function validDriverApplication(data){return data.serviceType in ['taxi','delivery','other']&&((data.serviceType=='taxi'&&data.vehicleType!='دراجة')||data.serviceType=='delivery'||data.serviceType=='other');}
 match /users/{uid}{
   function changedOnly(fields){return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);}
   function walletDebitValid(){
     let oid=request.resource.data.get('lastWalletOrderId','');
     return oid is string && oid.size()>0
       && changedOnly(['balance','lastWalletOrderId','updatedAt'])
       && request.resource.data.balance is number && request.resource.data.balance>=0
       && resource.data.get('balance',0)>=request.resource.data.balance
       && existsAfter(/databases/$(database)/documents/orders/$(oid))
       && getAfter(/databases/$(database)/documents/orders/$(oid)).data.userId==uid
       && getAfter(/databases/$(database)/documents/orders/$(oid)).data.get('walletApplied',false)==true
       && getAfter(/databases/$(database)/documents/orders/$(oid)).data.get('walletUsed',0)==resource.data.get('balance',0)-request.resource.data.balance
       && getAfter(/databases/$(database)/documents/orders/$(oid)).data.cancelled==false;
   }
   function walletRefundValid(){
     let oid=request.resource.data.get('lastWalletRefundOrderId','');
     return oid is string && oid.size()>0
       && changedOnly(['balance','lastWalletRefundOrderId','updatedAt'])
       && request.resource.data.balance is number && request.resource.data.balance>=resource.data.get('balance',0)
       && exists(/databases/$(database)/documents/orders/$(oid))
       && get(/databases/$(database)/documents/orders/$(oid)).data.userId==uid
       && get(/databases/$(database)/documents/orders/$(oid)).data.cancelled==false
       && getAfter(/databases/$(database)/documents/orders/$(oid)).data.cancelled==true
       && get(/databases/$(database)/documents/orders/$(oid)).data.get('walletUsed',0)==request.resource.data.balance-resource.data.get('balance',0);
   }
   function referralCodeSetupValid(){
     let code=request.resource.data.get('referralCode','');
     return changedOnly(['referralCode','updatedAt'])
       && !resource.data.keys().hasAny(['referralCode'])
       && code is string && code.matches('^[A-Z0-9]{4,14}$')
       && existsAfter(/databases/$(database)/documents/referralCodes/$(code))
       && getAfter(/databases/$(database)/documents/referralCodes/$(code)).data.ownerUid==uid
       && getAfter(/databases/$(database)/documents/referralCodes/$(code)).data.active==true;
   }
   function referralAttachValid(){
     let code=request.resource.data.get('referralCodeUsed','');
     let rr=getAfter(/databases/$(database)/documents/referrals/$(uid)).data;
     let cfg=get(/databases/$(database)/documents/platformSettings/pricing).data.get('referral',{});
     let credited=rr.get('inviteeCreditGranted',false)==true;
     let credit=rr.get('inviteeCreditAmount',0);
     return !resource.data.keys().hasAny(['referredBy','referralCodeUsed'])
       && existsAfter(/databases/$(database)/documents/referrals/$(uid))
       && rr.inviteeUid==uid
       && rr.inviterUid==request.resource.data.referredBy
       && rr.code==code
       && ((credited
         && credit==cfg.get('inviteeReward',0)
         && changedOnly(['referredBy','referralCodeUsed','balance','lastReferralCreditId','updatedAt'])
         && request.resource.data.lastReferralCreditId==uid
         && request.resource.data.balance-resource.data.get('balance',0)==credit)
       || (!credited
         && credit==0
         && changedOnly(['referredBy','referralCodeUsed','updatedAt'])));
   }
   function inviteeRewardValid(){
     let rb=get(/databases/$(database)/documents/referrals/$(uid)).data;
     let ra=getAfter(/databases/$(database)/documents/referrals/$(uid)).data;
     let cfg=get(/databases/$(database)/documents/platformSettings/pricing).data.referral;
     return changedOnly(['balance','lastReferralRewardId','updatedAt'])
       && request.resource.data.lastReferralRewardId==uid
       && rb.status=='pending' && ra.status=='rewarded'
       && rb.get('inviteeCreditGranted',false)!=true
       && ra.inviteeUid==uid
       && request.resource.data.balance-resource.data.get('balance',0)==cfg.inviteeReward;
   }
   function inviterRewardValid(){
     let rid=request.auth.uid;
     let rb=get(/databases/$(database)/documents/referrals/$(rid)).data;
     let ra=getAfter(/databases/$(database)/documents/referrals/$(rid)).data;
     let cfg=get(/databases/$(database)/documents/platformSettings/pricing).data.referral;
     return signed() && uid!=request.auth.uid
       && changedOnly(['balance','lastReferralRewardId','updatedAt'])
       && request.resource.data.lastReferralRewardId==rid
       && rb.status=='pending' && ra.status=='rewarded'
       && ra.inviterUid==uid
       && request.resource.data.balance-resource.data.get('balance',0)==cfg.inviterReward;
   }
   allow create:if own(uid)&&(request.resource.data.get('disabled',false)!=true)&&(request.resource.data.role=='driverApplicant'||request.resource.data.role=='serviceApplicant'||(request.resource.data.role=='customer'&&request.resource.data.get('balance',0)==0));
   allow read:if own(uid)||admin();
   allow update:if admin()
     || (own(uid)&&resource.data.get('disabled',false)!=true&&(
       changedOnly(['name','email','notifications','savedAddresses','updatedAt'])
       || (!resource.data.keys().hasAny(['role'])&&request.resource.data.role=='customer'&&changedOnly(['role','email','updatedAt']))
       || walletDebitValid() || walletRefundValid() || referralCodeSetupValid() || referralAttachValid() || inviteeRewardValid()
     ))
     || inviterRewardValid();
   allow delete:if admin();
   match /pushTokens/{id}{allow read:if own(uid)||admin();allow write:if own(uid)&&get(/databases/$(database)/documents/users/$(uid)).data.get('disabled',false)!=true;}
 }
 match /driverApplications/{uid}{allow create:if own(uid)&&request.resource.data.userId==request.auth.uid&&request.resource.data.status=='pending'&&validDriverApplication(request.resource.data);allow read:if own(uid)||admin();allow update:if admin()||(own(uid)&&resource.data.status!='approved'&&request.resource.data.userId==request.auth.uid&&request.resource.data.status=='pending'&&validDriverApplication(request.resource.data)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','phone','serviceType','vehicleType','vehicleMake','vehicleModel','vehicleCondition','plate','city','status','profileComplete','submittedAt','updatedAt']));allow delete:if admin();}
 match /drivers/{uid}{
   allow read:if admin()||driver()||own(uid);
   allow create,delete:if admin();
   allow update:if admin()||(own(uid)&&driver()&&(
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online','latitude','longitude','locationAccuracy','locationUpdatedAt','updatedAt'])
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeOrderId','activeOrderCode','busySince','updatedAt'])&&(
       (resource.data.get('activeOrderId','')==''
         && request.resource.data.activeOrderId is string
         && request.resource.data.activeOrderId.size()>0
         && request.resource.data.activeOrderCode is string
         && request.resource.data.busySince is timestamp
         && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.activeOrderId)).data.driverId==uid
         && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.activeOrderId)).data.cancelled==false
         && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.activeOrderId)).data.statusIndex<4)
       || (resource.data.get('activeOrderId','')!=''
         && request.resource.data.activeOrderId==''
         && request.resource.data.activeOrderCode==''
         && request.resource.data.busySince==null
         && (getAfter(/databases/$(database)/documents/orders/$(resource.data.activeOrderId)).data.cancelled==true
           || getAfter(/databases/$(database)/documents/orders/$(resource.data.activeOrderId)).data.statusIndex>=4))
     ))
   ));
 }
 match /publicDrivers/{uid}{
   function privateDriver(){return get(/databases/$(database)/documents/drivers/$(uid)).data;}
   allow read:if signed();
   allow create,update:if own(uid)&&driver()
     && exists(/databases/$(database)/documents/drivers/$(uid))
     && privateDriver().get('blocked',false)!=true
     && request.resource.data.keys().hasOnly(['driverId','name','vehicleType','online','latitude','longitude','locationAccuracy','locationUpdatedAt','updatedAt'])
     && request.resource.data.driverId==uid
     && request.resource.data.name is string
     && request.resource.data.name==userDoc().get('name','')
     && request.resource.data.name.size()>=2
     && request.resource.data.name.size()<=80
     && request.resource.data.vehicleType is string
     && request.resource.data.vehicleType==privateDriver().get('vehicleType','مركبة')
     && request.resource.data.online==true
     && request.resource.data.latitude is number
     && request.resource.data.latitude>=-90
     && request.resource.data.latitude<=90
     && request.resource.data.longitude is number
     && request.resource.data.longitude>=-180
     && request.resource.data.longitude<=180
     && request.resource.data.locationAccuracy is number
     && request.resource.data.locationAccuracy>=0
     && request.resource.data.locationUpdatedAt is timestamp
     && request.resource.data.updatedAt is timestamp;
   allow delete:if admin()||(own(uid)&&driver());
 }
 match /platformSettings/{id}{allow read:if signed();allow create,update,delete:if admin();}
 match /topupRequests/{id}{
   function paymentCfg(){return get(/databases/$(database)/documents/platformSettings/payments).data;}
   allow read:if admin()||(customer()&&resource.data.userId==request.auth.uid);
   allow create:if customer()
     && id.matches('^MC_[A-Za-z0-9_]{8,70}$')
     && request.resource.data.userId==request.auth.uid
     && request.resource.data.status=='pending'
     && request.resource.data.method=='mastercard_local_transfer'
     && request.resource.data.amount is int
     && request.resource.data.amount>=paymentCfg().get('minTopup',5000)
     && request.resource.data.amount<=paymentCfg().get('maxTopup',1000000)
     && request.resource.data.reference is string && request.resource.data.reference.size()>=3 && request.resource.data.reference.size()<=80
     && request.resource.data.customerName is string && request.resource.data.customerName.size()<=80
     && request.resource.data.customerEmail is string && request.resource.data.customerEmail.size()<=160
     && request.resource.data.keys().hasOnly(['userId','customerName','customerEmail','amount','reference','method','status','createdAt','updatedAt'])
     && paymentCfg().get('mastercardEnabled',false)==true;
   allow update,delete:if admin();
 }
 match /walletTransactions/{id}{allow read:if signed()&&((resource.data.get('userId','')==request.auth.uid)||(resource.data.get('driverId','')==request.auth.uid)||admin());allow create,update,delete:if admin();}
 match /referrals/{id}{
   function referralCfg(){return get(/databases/$(database)/documents/platformSettings/pricing).data.referral;}
   allow read:if signed()&&(id==request.auth.uid||resource.data.get('inviterUid','')==request.auth.uid||admin());
   allow create:if customer()&&id==request.auth.uid
     && request.resource.data.inviteeUid==request.auth.uid
     && request.resource.data.inviterUid is string&&request.resource.data.inviterUid!=request.auth.uid
     && request.resource.data.code is string
     && request.resource.data.status=='pending'
     && ((request.resource.data.get('inviteeCreditGranted',false)==true
          && request.resource.data.get('inviteeCreditAmount',0)==referralCfg().get('inviteeReward',0)
          && referralCfg().get('enabled',true)!=false)
       || (request.resource.data.get('inviteeCreditGranted',false)==false
          && request.resource.data.get('inviteeCreditAmount',0)==0))
     && exists(/databases/$(database)/documents/referralCodes/$(request.resource.data.code))
     && get(/databases/$(database)/documents/referralCodes/$(request.resource.data.code)).data.ownerUid==request.resource.data.inviterUid
     && get(/databases/$(database)/documents/referralCodes/$(request.resource.data.code)).data.active==true;
   allow update:if admin()||(customer()&&id==request.auth.uid
     && resource.data.status=='pending'&&request.resource.data.status=='rewarded'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','rewardedOrderId','rewardedAt','inviterReward','inviteeReward'])
     && request.resource.data.inviterReward==referralCfg().inviterReward
     && request.resource.data.inviteeReward==referralCfg().inviteeReward
     && (referralCfg().get('inviterReward',0)==0
       || (getAfter(/databases/$(database)/documents/users/$(resource.data.inviterUid)).data.get('balance',0)==get(/databases/$(database)/documents/users/$(resource.data.inviterUid)).data.get('balance',0)+referralCfg().get('inviterReward',0)
         && getAfter(/databases/$(database)/documents/users/$(resource.data.inviterUid)).data.get('lastReferralRewardId','')==request.auth.uid))
     && (resource.data.get('inviteeCreditGranted',false)==true || referralCfg().get('inviteeReward',0)==0
       || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('balance',0)==userDoc().get('balance',0)+referralCfg().get('inviteeReward',0))
     && exists(/databases/$(database)/documents/orders/$(request.resource.data.rewardedOrderId))
     && get(/databases/$(database)/documents/orders/$(request.resource.data.rewardedOrderId)).data.userId==request.auth.uid
     && get(/databases/$(database)/documents/orders/$(request.resource.data.rewardedOrderId)).data.cancelled==false
     && get(/databases/$(database)/documents/orders/$(request.resource.data.rewardedOrderId)).data.statusIndex>=4);
   allow delete:if admin();
 }
 match /referralCodes/{id}{allow read:if signed();allow create:if customer()&&request.resource.data.ownerUid==request.auth.uid&&request.resource.data.active==true;allow update:if admin();allow delete:if admin();}
 match /promoCodes/{id}{allow read:if admin();allow write:if admin();}
 match /orders/{id}{
   function linkedServiceRequest(){return getAfter(/databases/$(database)/documents/serviceRequests/$(request.resource.data.serviceRequestId)).data;}
   function pricingCfg(){return get(/databases/$(database)/documents/platformSettings/pricing).data;}
   function configuredOrderCommission(){
     let data=request.resource.data;
     return !exists(/databases/$(database)/documents/platformSettings/pricing) ? 0.15
       : (data.type=='ride'
         ? pricingCfg().get('taxi',{}).get(data.get('vehicleKey','economy'),{}).get('commissionRate',0.15)
         : pricingCfg().get('deliveryCommissions',{}).get(data.type,0.15));
   }
   function orderCommissionValid(){
     let data=request.resource.data;
     let rate=configuredOrderCommission();
     let amount=data.get('commissionAmount',-1);
     let earnings=data.get('driverEarnings',-1);
     return data.get('commissionRate',-1) is number
       && data.commissionRate==rate && rate>=0 && rate<=0.8
       && amount is number && amount>=0
       && earnings is number && earnings>=0
       && amount+earnings==data.price
       && amount>=data.price*rate-1 && amount<=data.price*rate+1;
   }
   function orderClassificationValid(){
     let data=request.resource.data;
     return (data.type=='ride'
         && data.requiredDriverService=='taxi'
         && data.get('vehicleKey','') in ['economy','taxi','family']
         && ((data.vehicleKey=='economy'&&data.get('vehicle','')=='اقتصادي')
           || (data.vehicleKey=='taxi'&&data.get('vehicle','')=='تكسي')
           || (data.vehicleKey=='family'&&data.get('vehicle','')=='عائلي')))
       || (data.type in ['parcel','food']&&data.requiredDriverService=='delivery')
       || (data.type=='serviceDelivery'&&data.requiredDriverService=='delivery');
   }
   function customerPaymentValid(){
     let w=request.resource.data.get('walletUsed',0);
     let c=request.resource.data.get('cashDue',request.resource.data.price);
     let before=userDoc().get('balance',0);
     let after=getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
     return request.resource.data.price is number&&request.resource.data.price>=0
       && w is number&&w>=0&&w<=before
       && c is number&&c>=0&&c==request.resource.data.price-w
       && request.resource.data.get('walletApplied',false)==true
       && ((w==0&&after.get('balance',0)==before)||(w>0&&after.get('balance',0)==before-w&&after.get('lastWalletOrderId','')==id));
   }
   function currentDriver(){return get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data;}
   function pickupOtpMatches(){
     return resource.data.type=='serviceDelivery'
       && resource.data.serviceRequestId is string
       && resource.data.serviceRequestId.size()>0
       && request.resource.data.pickupVerificationCode is string
       && request.resource.data.pickupVerificationCode.matches('^[0-9]{4}$')
       && exists(/databases/$(database)/documents/serviceRequests/$(resource.data.serviceRequestId))
       && get(/databases/$(database)/documents/serviceRequests/$(resource.data.serviceRequestId)).data.providerId==resource.data.providerId
       && get(/databases/$(database)/documents/serviceRequests/$(resource.data.serviceRequestId)).data.get('pickupOtp','')==request.resource.data.pickupVerificationCode;
   }
   // حماية إضافية عند قبول الطلب: موقع الكابتن المسجل يجب أن يكون قريبًا من نقطة بداية الطلب.
   // الواجهة تطبق Haversine بدقة 10 كم؛ هذه الدالة تمنع تجاوزًا مباشرًا من عميل معدل.
   function driverNearPickup10Km(){
     let d=currentDriver();
     let p=resource.data.pickupLocation;
     let dLat=(p.latitude-d.latitude)*111.32;
     let lonFactor=d.latitude>=35?90:(d.latitude>=33?92:(d.latitude>=31?94.5:97));
     let dLon=(p.longitude-d.longitude)*lonFactor;
     return p is map
       && p.latitude is number && p.longitude is number
       && d.latitude is number && d.longitude is number
       && dLat*dLat+dLon*dLon<=100;
   }
   function taxiOrderVisible(){return driver()&&currentDriver().get('serviceType','')=='taxi'&&currentDriver().get('vehicleType','')!='دراجة'&&resource.data.type=='ride';}
   function deliveryOrderVisible(){return driver()&&currentDriver().get('serviceType','')=='delivery'&&currentDriver().get('vehicleType','') in ['اقتصادي','تكسي','عائلي','دراجة']&&resource.data.type in ['parcel','food','serviceDelivery'];}
   allow read:if signed()&&(resource.data.userId==request.auth.uid||resource.data.driverId==request.auth.uid||taxiOrderVisible()||deliveryOrderVisible()||admin()||(serviceProvider()&&resource.data.get('providerId','')==request.auth.uid));
   allow create:if admin()
     || (customer()
       && request.resource.data.userId==request.auth.uid
       && request.resource.data.type in ['ride','parcel','food']
       && request.resource.data.driverId==null
       && request.resource.data.statusIndex==0
       && request.resource.data.cancelled==false
       && customerPaymentValid()
       && orderClassificationValid()
       && orderCommissionValid())
     || (customer()
       && request.resource.data.type=='serviceDelivery'
       && request.resource.data.userId==request.auth.uid
       && request.resource.data.providerId is string
       && request.resource.data.serviceRequestId is string
       && request.resource.data.serviceRequestId.size()>0
       && request.resource.data.driverId==null
       && request.resource.data.statusIndex==0
       && request.resource.data.cancelled==false
       && request.resource.data.requiredDriverService=='delivery'
       && customerPaymentValid()
       && orderClassificationValid()
       && orderCommissionValid()
       && request.resource.data.commissionRate is number&&request.resource.data.commissionRate>=0&&request.resource.data.commissionRate<=0.8
       && request.resource.data.commissionAmount is number&&request.resource.data.commissionAmount>=0
       && request.resource.data.driverEarnings is number&&request.resource.data.driverEarnings>=0
       && request.resource.data.commissionAmount+request.resource.data.driverEarnings==request.resource.data.price
       && linkedServiceRequest().customerId==request.auth.uid
       && linkedServiceRequest().providerId==request.resource.data.providerId
       && linkedServiceRequest().status=='accepted'
       && linkedServiceRequest().deliveryRequested==true
       && linkedServiceRequest().deliveryStatus=='awaitingCaptain'
       && linkedServiceRequest().deliveryOrderId==id
       && linkedServiceRequest().providerCity==request.resource.data.serviceCity
       && linkedServiceRequest().providerLocation==request.resource.data.pickupLocation
       && linkedServiceRequest().customerLocation==request.resource.data.destinationLocation
       && linkedServiceRequest().totalPrice==request.resource.data.serviceTotal
       && linkedServiceRequest().deliveryFee==request.resource.data.price)
     || (serviceProvider()
       && request.resource.data.type=='serviceDelivery'
       && request.resource.data.providerId==request.auth.uid
       && request.resource.data.serviceRequestId is string
       && request.resource.data.serviceRequestId.size()>0
       && request.resource.data.driverId==null
       && request.resource.data.statusIndex==0
       && request.resource.data.cancelled==false
       && request.resource.data.requiredDriverService=='delivery'
       && request.resource.data.payment=='نقدًا'
       && orderClassificationValid()
       && orderCommissionValid()
       && request.resource.data.commissionRate is number&&request.resource.data.commissionRate>=0&&request.resource.data.commissionRate<=0.8
       && request.resource.data.commissionAmount is number&&request.resource.data.commissionAmount>=0
       && request.resource.data.driverEarnings is number&&request.resource.data.driverEarnings>=0
       && request.resource.data.commissionAmount+request.resource.data.driverEarnings==request.resource.data.price
       && linkedServiceRequest().providerCategory=='restaurant'
       && linkedServiceRequest().providerId==request.auth.uid
       && linkedServiceRequest().customerId==request.resource.data.userId
       && linkedServiceRequest().status=='accepted'
       && linkedServiceRequest().deliveryRequested==true
       && linkedServiceRequest().deliveryStatus=='awaitingCaptain'
       && linkedServiceRequest().deliveryOrderId==id
       && linkedServiceRequest().providerCity==request.resource.data.serviceCity
       && linkedServiceRequest().providerLocation==request.resource.data.pickupLocation
       && linkedServiceRequest().customerLocation==request.resource.data.destinationLocation
       && linkedServiceRequest().totalPrice==request.resource.data.serviceTotal
       && linkedServiceRequest().deliveryFee==request.resource.data.price);
   allow update:if admin()
     || (customer()&&resource.data.userId==request.auth.uid&&resource.data.cancelled==false&&request.resource.data.cancelled==true&&request.resource.data.cancelledBy=='customer'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled','cancellationReason','cancelledBy','cancelledAt','updatedAt'])&&(resource.data.get('walletUsed',0)==0||(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('balance',0)==userDoc().get('balance',0)+resource.data.get('walletUsed',0)&&getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('lastWalletRefundOrderId','')==id)))
     || (driver() && (
       (resource.data.driverId==null && resource.data.cancelled==false && resource.data.statusIndex==0 && request.resource.data.driverId==request.auth.uid && request.resource.data.statusIndex==resource.data.statusIndex && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverId','driverName','driverPhone','assignmentStatus','acceptedAt','updatedAt'])
         && ((resource.data.type=='ride' && currentDriver().get('serviceType','')=='taxi' && currentDriver().get('vehicleType','')!='دراجة')
           || (resource.data.type in ['parcel','food','serviceDelivery'] && currentDriver().get('serviceType','')=='delivery' && currentDriver().get('vehicleType','') in ['اقتصادي','تكسي','عائلي','دراجة'] && (resource.data.type!='serviceDelivery' || currentDriver().get('city','')==resource.data.get('serviceCity',''))))
         && driverNearPickup10Km()
         && currentDriver().get('activeOrderId','')=='' && getAfter(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.activeOrderId==id)
       || (resource.data.driverId==request.auth.uid && request.resource.data.driverId==request.auth.uid && request.resource.data.statusIndex==resource.data.statusIndex+1 && request.resource.data.statusIndex<=4 && !(resource.data.type=='serviceDelivery'&&resource.data.statusIndex==2) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusIndex','arrivedAt','startedAt','completedAt','paymentStatus','updatedAt']))
       || (resource.data.driverId==request.auth.uid && request.resource.data.driverId==request.auth.uid && resource.data.type=='serviceDelivery' && resource.data.statusIndex==2 && request.resource.data.statusIndex==3 && pickupOtpMatches() && request.resource.data.pickupVerifiedAt is timestamp && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusIndex','startedAt','pickupVerificationCode','pickupVerifiedAt','updatedAt']))
       || (resource.data.driverId==request.auth.uid && request.resource.data.driverId==request.auth.uid && resource.data.cancelled==false && request.resource.data.cancelled==true && request.resource.data.cancelledBy=='driver' && request.resource.data.statusIndex==resource.data.statusIndex && resource.data.statusIndex<4 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled','cancelledBy','cancellationReason','cancelledAt','assignmentStatus','updatedAt']))
     ));
   allow delete:if admin();
   match /tracking/{tid}{function o(){return get(/databases/$(database)/documents/orders/$(id)).data;}allow read:if signed()&&(o().userId==request.auth.uid||o().driverId==request.auth.uid||admin());allow create,update:if driver()&&o().driverId==request.auth.uid&&request.resource.data.driverId==request.auth.uid;allow delete:if admin();}
 }
 match /orderSecrets/{id}{
   allow read:if admin()||(signed()&&resource.data.userId==request.auth.uid);
   allow create:if customer()
     && request.resource.data.userId==request.auth.uid
     && request.resource.data.keys().hasOnly(['userId','tripOtp','createdAt'])
     && request.resource.data.tripOtp is string
     && request.resource.data.tripOtp.matches('^[0-9]{4}$')
     && getAfter(/databases/$(database)/documents/orders/$(id)).data.userId==request.auth.uid;
   allow update,delete:if false;
 }
 match /supportTickets/{id}{allow create:if signed()&&request.resource.data.userId==request.auth.uid;allow read:if signed()&&(resource.data.userId==request.auth.uid||admin());allow update:if admin();allow delete:if admin();}
 match /coupons/{id}{allow read:if signed();allow write:if admin();}
 match /auditLogs/{id}{allow read:if admin();allow write:if false;}
 match /notificationQueue/{id}{allow read:if admin();allow write:if false;}
 match /authChallenges/{id}{allow read,write:if false;}
 match /authRateLimits/{id}{allow read,write:if false;}
 match /safetyEvents/{id}{
   function linked(){return get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data;}
   allow read:if admin()||(signed()&&(resource.data.reportedBy==request.auth.uid));
   allow create:if signed()&&request.resource.data.reportedBy==request.auth.uid
     && request.resource.data.orderId is string
     && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
     && (linked().userId==request.auth.uid||linked().driverId==request.auth.uid);
   allow update,delete:if admin();
 }

 match /serviceApplications/{uid}{
   function validApplication(data){return data.userId==uid
     && data.ownerName is string && data.ownerName.size()>=2 && data.ownerName.size()<=80
     && data.businessName is string && data.businessName.size()>=2 && data.businessName.size()<=80
     && validServiceCategory(data.category)
     && data.phone is string && data.phone.size()>=8 && data.phone.size()<=20
     && data.email is string && data.email.size()>=3 && data.email.size()<=160
     && data.city is string && data.city.size()>=2 && data.city.size()<=50
     && data.address is string && data.address.size()>=3 && data.address.size()<=160
     && data.location is map
     && data.location.latitude is number && data.location.latitude>=-90 && data.location.latitude<=90
     && data.location.longitude is number && data.location.longitude>=-180 && data.location.longitude<=180
     && data.get('description','') is string && data.get('description','').size()<=500
     && data.serviceType=='other';}
   allow create:if own(uid)
     && getAfter(/databases/$(database)/documents/users/$(uid)).data.get('role',null)=='serviceApplicant'
     && request.resource.data.status=='pending'
     && validApplication(request.resource.data)
     && request.resource.data.keys().hasOnly(['userId','ownerName','businessName','category','serviceType','phone','email','city','address','location','description','status','reviewNote','submittedAt','updatedAt']);
   allow read:if own(uid)||admin();
   allow update:if admin()||(own(uid)
     && serviceApplicant()
     && resource.data.status!='approved'
     && request.resource.data.status=='pending'
     && validApplication(request.resource.data)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName','businessName','category','phone','email','city','address','location','description','status','reviewNote','resubmittedAt','updatedAt']));
   allow delete:if admin();
 }

 match /serviceProfiles/{uid}{
   function validProfile(data){return data.ownerId==uid
     && data.businessName is string && data.businessName.size()>=2 && data.businessName.size()<=80
     && validServiceCategory(data.category)
     && data.phone is string && data.phone.size()>=8 && data.phone.size()<=20
     && data.city is string && data.city.size()<=50
     && data.address is string && data.address.size()>=3 && data.address.size()<=160
     && data.location is map
     && data.location.latitude is number && data.location.latitude>=-90 && data.location.latitude<=90
     && data.location.longitude is number && data.location.longitude>=-180 && data.location.longitude<=180
     && data.get('description','') is string && data.get('description','').size()<=500
     && data.get('items',[]) is list && data.get('items',[]).size()<=50
     && data.active is bool
     && data.approvalStatus=='approved';}
   allow read:if admin()||own(uid)||(signed()&&resource.data.active==true&&resource.data.approvalStatus=='approved');
   allow create:if admin()||(own(uid)&&serviceProvider()&&validProfile(request.resource.data));
   allow update:if admin()||(own(uid)
     && serviceProvider()
     && validProfile(request.resource.data)
     && request.resource.data.ownerId==resource.data.ownerId
     && request.resource.data.category==resource.data.category
     && request.resource.data.approvalStatus==resource.data.approvalStatus
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['businessName','phone','city','address','description','location','items','active','updatedAt']));
   allow delete:if admin();
 }

 match /serviceRequests/{id}{
   function providerProfile(){return get(/databases/$(database)/documents/serviceProfiles/$(request.resource.data.providerId)).data;}
   function providerItem(){return providerProfile().items[request.resource.data.itemIndex];}
   function serviceCommissionRate(){return get(/databases/$(database)/documents/platformSettings/pricing).data.get('serviceCommissions',{}).get(request.resource.data.providerCategory,0.15);}
   function deliveryOrderAfter(){return getAfter(/databases/$(database)/documents/orders/$(request.resource.data.deliveryOrderId)).data;}

   // المطاعم تحتفظ بمسارها السابق: العميل يختار التوصيل مع الوجبة قبل موافقة المطعم.
   allow create:if customer()
     && request.resource.data.providerCategory=='restaurant'
     && request.resource.data.customerId==request.auth.uid
     && request.resource.data.customerName==userDoc().get('name','')
     && request.resource.data.providerId is string && request.resource.data.providerId.size()>0
     && providerProfile().active==true && providerProfile().approvalStatus=='approved'
     && request.resource.data.providerName==providerProfile().businessName
     && request.resource.data.serviceCommissionRate is number && request.resource.data.serviceCommissionRate>=0 && request.resource.data.serviceCommissionRate<=0.8 && request.resource.data.serviceCommissionRate==serviceCommissionRate()
     && request.resource.data.providerCity==providerProfile().city
     && request.resource.data.providerAddress==providerProfile().address
     && request.resource.data.providerLocation==providerProfile().location
     && request.resource.data.status=='pending'
     && request.resource.data.itemIndex is int && request.resource.data.itemIndex>=0 && request.resource.data.itemIndex<providerProfile().items.size()
     && request.resource.data.itemName is string && request.resource.data.itemName.size()>=2 && request.resource.data.itemName.size()<=80
     && request.resource.data.itemName==providerItem().name
     && request.resource.data.itemUnit==providerItem().get('unit','item')
     && request.resource.data.unitPrice is number && request.resource.data.unitPrice>0 && request.resource.data.unitPrice==providerItem().price
     && request.resource.data.itemPrice==request.resource.data.unitPrice
     && request.resource.data.quantity is number && request.resource.data.quantity>0 && request.resource.data.quantity<=100
     && (request.resource.data.itemUnit=='kg'||request.resource.data.quantity is int)
     && request.resource.data.subtotal==request.resource.data.unitPrice*request.resource.data.quantity
     && request.resource.data.deliveryRequested is bool
     && request.resource.data.deliveryFee is number && request.resource.data.deliveryFee>=0
     && ((!request.resource.data.deliveryRequested&&request.resource.data.deliveryFee==0&&request.resource.data.deliveryStatus=='notRequested'&&request.resource.data.customerLocation==null)||(request.resource.data.deliveryRequested&&providerItem().get('deliveryAvailable',false)==true&&request.resource.data.deliveryFee==providerItem().get('deliveryFee',0)&&request.resource.data.deliveryStatus=='pendingProvider'&&request.resource.data.customerLocation is map&&request.resource.data.customerLocation.latitude is number&&request.resource.data.customerLocation.latitude>=-90&&request.resource.data.customerLocation.latitude<=90&&request.resource.data.customerLocation.longitude is number&&request.resource.data.customerLocation.longitude>=-180&&request.resource.data.customerLocation.longitude<=180))
     && request.resource.data.deliveryOrderId==''
     && request.resource.data.totalPrice==request.resource.data.subtotal+request.resource.data.deliveryFee
     && request.resource.data.requestText is string && request.resource.data.requestText.size()>=3 && request.resource.data.requestText.size()<=500
     && request.resource.data.customerAddress is string && request.resource.data.customerAddress.size()>=3 && request.resource.data.customerAddress.size()<=180
     && request.resource.data.keys().hasOnly(['customerId','customerName','providerId','providerName','providerCategory','serviceCommissionRate','providerCity','providerAddress','providerLocation','itemIndex','itemName','itemUnit','quantity','unitPrice','itemPrice','subtotal','deliveryRequested','deliveryFee','totalPrice','deliveryStatus','deliveryOrderId','requestText','customerAddress','customerLocation','status','createdAt','updatedAt']);

   // الخدمات الأخرى: يختار العميل حاجته وسعرها أولًا، ثم يحدد التوصيل بعد موافقة مقدم الخدمة.
   allow create:if customer()
     && request.resource.data.providerCategory!='restaurant'
     && request.resource.data.customerId==request.auth.uid
     && request.resource.data.customerName==userDoc().get('name','')
     && request.resource.data.providerId is string && request.resource.data.providerId.size()>0
     && providerProfile().active==true && providerProfile().approvalStatus=='approved'
     && request.resource.data.providerName==providerProfile().businessName
     && request.resource.data.serviceCommissionRate is number && request.resource.data.serviceCommissionRate>=0 && request.resource.data.serviceCommissionRate<=0.8 && request.resource.data.serviceCommissionRate==serviceCommissionRate()
     && request.resource.data.providerCity==providerProfile().city
     && request.resource.data.providerAddress==providerProfile().address
     && request.resource.data.providerLocation==providerProfile().location
     && request.resource.data.status=='pending'
     && request.resource.data.itemIndex is int && request.resource.data.itemIndex>=0 && request.resource.data.itemIndex<providerProfile().items.size()
     && request.resource.data.itemName is string && request.resource.data.itemName.size()>=2 && request.resource.data.itemName.size()<=80
     && request.resource.data.itemName==providerItem().name
     && request.resource.data.itemUnit==providerItem().get('unit','item')
     && request.resource.data.unitPrice is number && request.resource.data.unitPrice>0 && request.resource.data.unitPrice==providerItem().price
     && request.resource.data.itemPrice==request.resource.data.unitPrice
     && request.resource.data.quantity is number && request.resource.data.quantity>0 && request.resource.data.quantity<=100
     && (request.resource.data.itemUnit=='kg'||request.resource.data.quantity is int)
     && request.resource.data.subtotal==request.resource.data.unitPrice*request.resource.data.quantity
     && request.resource.data.itemDeliveryAvailable is bool
     && request.resource.data.itemDeliveryAvailable==providerItem().get('deliveryAvailable',false)
     && request.resource.data.itemDeliveryFee is number && request.resource.data.itemDeliveryFee>=0
     && ((!request.resource.data.itemDeliveryAvailable&&request.resource.data.itemDeliveryFee==0)||(request.resource.data.itemDeliveryAvailable&&request.resource.data.itemDeliveryFee==providerItem().get('deliveryFee',0)))
     && request.resource.data.deliveryRequested==false
     && request.resource.data.deliveryFee==0
     && ((!request.resource.data.itemDeliveryAvailable&&request.resource.data.deliveryStatus=='notAvailable')||(request.resource.data.itemDeliveryAvailable&&request.resource.data.deliveryStatus=='pendingProvider'))
     && request.resource.data.deliveryOrderId==''
     && request.resource.data.totalPrice==request.resource.data.subtotal
     && request.resource.data.requestText is string && request.resource.data.requestText.size()>=3 && request.resource.data.requestText.size()<=500
     && request.resource.data.customerAddress==''
     && request.resource.data.customerLocation==null
     && request.resource.data.keys().hasOnly(['customerId','customerName','providerId','providerName','providerCategory','serviceCommissionRate','providerCity','providerAddress','providerLocation','itemIndex','itemName','itemUnit','quantity','unitPrice','itemPrice','subtotal','itemDeliveryAvailable','itemDeliveryFee','deliveryRequested','deliveryFee','totalPrice','deliveryStatus','deliveryOrderId','requestText','customerAddress','customerLocation','status','createdAt','updatedAt']);

   allow read:if admin()||(customer()&&resource.data.customerId==request.auth.uid)||(serviceProvider()&&resource.data.providerId==request.auth.uid);
   allow update:if admin()
     || (customer()&&resource.data.customerId==request.auth.uid&&resource.data.status=='pending'&&request.resource.data.status=='cancelled'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','updatedAt']))
     || (customer()
       && resource.data.providerCategory!='restaurant'
       && resource.data.customerId==request.auth.uid
       && resource.data.status=='accepted'
       && resource.data.deliveryStatus=='awaitingCustomerChoice'
       && resource.data.get('itemDeliveryAvailable',false)==true
       && request.resource.data.status=='accepted'
       && request.resource.data.deliveryRequested==true
       && request.resource.data.deliveryFee==resource.data.get('itemDeliveryFee',0)
       && request.resource.data.totalPrice==resource.data.subtotal+resource.data.get('itemDeliveryFee',0)
       && request.resource.data.deliveryStatus=='awaitingCaptain'
       && request.resource.data.deliveryOrderId is string && request.resource.data.deliveryOrderId.size()>0
       && request.resource.data.customerAddress is string && request.resource.data.customerAddress.size()>=3 && request.resource.data.customerAddress.size()<=180
       && request.resource.data.customerLocation is map
       && request.resource.data.customerLocation.latitude is number&&request.resource.data.customerLocation.latitude>=-90&&request.resource.data.customerLocation.latitude<=90
       && request.resource.data.customerLocation.longitude is number&&request.resource.data.customerLocation.longitude>=-180&&request.resource.data.customerLocation.longitude<=180
       && request.resource.data.pickupOtp is string && request.resource.data.pickupOtp.matches('^[0-9]{4}$')
       && request.resource.data.deliveryChosenAt is timestamp
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryRequested','deliveryFee','totalPrice','deliveryStatus','deliveryOrderId','pickupOtp','customerAddress','customerLocation','deliveryChosenAt','updatedAt'])
       && existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.deliveryOrderId))
       && deliveryOrderAfter().type=='serviceDelivery'
       && deliveryOrderAfter().serviceRequestId==id
       && deliveryOrderAfter().userId==request.auth.uid
       && deliveryOrderAfter().providerId==resource.data.providerId
       && deliveryOrderAfter().requiredDriverService=='delivery'
       && deliveryOrderAfter().driverId==null
       && deliveryOrderAfter().statusIndex==0
       && deliveryOrderAfter().cancelled==false
       && deliveryOrderAfter().pickupLocation==resource.data.providerLocation
       && deliveryOrderAfter().destinationLocation==request.resource.data.customerLocation
       && deliveryOrderAfter().serviceCity==resource.data.providerCity
       && deliveryOrderAfter().price==request.resource.data.deliveryFee
       && deliveryOrderAfter().serviceTotal==request.resource.data.totalPrice)
     || (customer()
       && resource.data.providerCategory!='restaurant'
       && resource.data.customerId==request.auth.uid
       && resource.data.status=='accepted'
       && resource.data.deliveryStatus=='awaitingCustomerChoice'
       && request.resource.data.status=='accepted'
       && request.resource.data.deliveryRequested==false
       && request.resource.data.deliveryFee==0
       && request.resource.data.totalPrice==resource.data.subtotal
       && request.resource.data.deliveryStatus=='notRequested'
       && request.resource.data.deliveryOrderId==''
       && request.resource.data.customerAddress=='استلام من النشاط'
       && request.resource.data.customerLocation==null
       && request.resource.data.deliveryChosenAt is timestamp
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryRequested','deliveryFee','totalPrice','deliveryStatus','customerAddress','customerLocation','deliveryChosenAt','updatedAt']))
     || (serviceProvider()
       && resource.data.providerId==request.auth.uid
       && request.resource.data.providerId==request.auth.uid
       && request.resource.data.get('providerNote','') is string
       && request.resource.data.get('providerNote','').size()<=300
       && (
         (resource.data.status=='pending'&&request.resource.data.status=='rejected'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','providerNote','statusUpdatedAt','updatedAt']))
         || (resource.data.status=='accepted'&&request.resource.data.status=='accepted'&&resource.data.get('deliveryStatus','')=='awaitingCaptain'&&resource.data.get('pickupOtp','')==''&&request.resource.data.pickupOtp is string&&request.resource.data.pickupOtp.matches('^[0-9]{4}$')&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pickupOtp','updatedAt']))
         || (resource.data.status=='accepted'&&request.resource.data.status=='completed'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','providerNote','statusUpdatedAt','updatedAt']))
         || (resource.data.providerCategory!='restaurant'
           && resource.data.status=='pending'&&request.resource.data.status=='accepted'
           && request.resource.data.deliveryOrderId==''
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','providerNote','deliveryStatus','deliveryOrderId','statusUpdatedAt','updatedAt'])
           && ((resource.data.get('itemDeliveryAvailable',false)==true&&request.resource.data.deliveryStatus=='awaitingCustomerChoice')||(resource.data.get('itemDeliveryAvailable',false)==false&&request.resource.data.deliveryStatus=='notRequested')))
         || (resource.data.providerCategory=='restaurant'
           && resource.data.status=='pending'&&request.resource.data.status=='accepted'
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','providerNote','deliveryStatus','deliveryOrderId','pickupOtp','statusUpdatedAt','updatedAt'])
           && ((!resource.data.get('deliveryRequested',false)&&request.resource.data.deliveryStatus=='notRequested'&&request.resource.data.deliveryOrderId==''&&request.resource.data.get('pickupOtp','')=='')||(resource.data.get('deliveryRequested',false)&&request.resource.data.pickupOtp is string&&request.resource.data.pickupOtp.matches('^[0-9]{4}$')&&request.resource.data.deliveryStatus=='awaitingCaptain'&&request.resource.data.deliveryOrderId is string&&request.resource.data.deliveryOrderId.size()>0&&existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.deliveryOrderId))&&getAfter(/databases/$(database)/documents/orders/$(request.resource.data.deliveryOrderId)).data.serviceRequestId==id&&getAfter(/databases/$(database)/documents/orders/$(request.resource.data.deliveryOrderId)).data.providerId==request.auth.uid))
       )));
   allow delete:if admin();
 }

 match /restaurants/{id}{
   allow read:if admin() || own(id) || (signed() && resource.data.ownerId==request.auth.uid) || (signed() && resource.data.active==true);
   allow create:if admin() || (signed()
     && request.resource.data.ownerId==request.auth.uid
     && serviceProvider()
     && getAfter(/databases/$(database)/documents/serviceProfiles/$(request.auth.uid)).data.get('category','')=='restaurant'
     && getAfter(/databases/$(database)/documents/serviceProfiles/$(request.auth.uid)).data.get('approvalStatus','')=='approved'
     && request.resource.data.active is bool
     && request.resource.data.approvalStatus=='approved'
     && request.resource.data.name is string && request.resource.data.name.size()>=2 && request.resource.data.name.size()<=80
     && request.resource.data.address is string && request.resource.data.address.size()>=3 && request.resource.data.address.size()<=160
     && request.resource.data.phone is string && request.resource.data.phone.size()>=8 && request.resource.data.phone.size()<=20
     && request.resource.data.location is map
     && request.resource.data.location.latitude is number && request.resource.data.location.latitude>=-90 && request.resource.data.location.latitude<=90
     && request.resource.data.location.longitude is number && request.resource.data.location.longitude>=-180 && request.resource.data.location.longitude<=180
     && request.resource.data.meals is list && request.resource.data.meals.size()>0 && request.resource.data.meals.size()<=50);
   allow update:if admin() || (signed()
     && resource.data.ownerId==request.auth.uid
     && request.resource.data.ownerId==request.auth.uid
     && serviceProvider()
     && get(/databases/$(database)/documents/serviceProfiles/$(request.auth.uid)).data.get('category','')=='restaurant'
     && get(/databases/$(database)/documents/serviceProfiles/$(request.auth.uid)).data.get('approvalStatus','')=='approved'
     && request.resource.data.approvalStatus==resource.data.approvalStatus
     && request.resource.data.name is string && request.resource.data.name.size()>=2 && request.resource.data.name.size()<=80
     && request.resource.data.address is string && request.resource.data.address.size()>=3 && request.resource.data.address.size()<=160
     && request.resource.data.phone is string && request.resource.data.phone.size()>=8 && request.resource.data.phone.size()<=20
     && request.resource.data.location is map
     && request.resource.data.location.latitude is number && request.resource.data.location.latitude>=-90 && request.resource.data.location.latitude<=90
     && request.resource.data.location.longitude is number && request.resource.data.location.longitude>=-180 && request.resource.data.location.longitude<=180
     && request.resource.data.meals is list && request.resource.data.meals.size()>0 && request.resource.data.meals.size()<=50
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','address','phone','location','meals','active','updatedAt']));
   allow delete:if admin();
 }
 match /roadReports/{id}{
   allow read:if signed();
   allow create:if driver()&&request.resource.data.reportedBy==request.auth.uid;
   allow update:if driver();
   allow delete:if admin();
 }
 match /landmarks/{id}{
   allow read:if signed();
   allow create:if signed()&&request.resource.data.createdBy==request.auth.uid;
   allow update,delete:if admin()||(signed()&&resource.data.createdBy==request.auth.uid);
 }
 match /tripShares/{id}{
   allow read:if admin()||(signed()&&resource.data.userId==request.auth.uid);
   allow create:if customer()&&request.resource.data.userId==request.auth.uid
     && request.resource.data.orderId is string
     && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
     && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId==request.auth.uid;
   allow update,delete:if admin()||(customer()&&resource.data.userId==request.auth.uid);
 }
 match /customerRatings/{id}{
   allow read:if admin()||(signed()&&(resource.data.customerId==request.auth.uid||resource.data.driverId==request.auth.uid));
   allow create:if driver()
     && request.resource.data.driverId==request.auth.uid
     && request.resource.data.orderId==id
     && request.resource.data.score is number&&request.resource.data.score>=1&&request.resource.data.score<=5
     && exists(/databases/$(database)/documents/orders/$(id))
     && get(/databases/$(database)/documents/orders/$(id)).data.driverId==request.auth.uid
     && get(/databases/$(database)/documents/orders/$(id)).data.userId==request.resource.data.customerId
     && get(/databases/$(database)/documents/orders/$(id)).data.statusIndex>=4;
   allow update:if false;allow delete:if admin();
 }
 match /ratings/{id}{function o(){return get(/databases/$(database)/documents/orders/$(id)).data;}allow create:if signed()&&o().userId==request.auth.uid&&o().statusIndex>=4&&request.resource.data.customerId==request.auth.uid;allow read:if signed()&&(resource.data.customerId==request.auth.uid||resource.data.driverId==request.auth.uid||admin());allow update:if false;allow delete:if admin();}
}}
