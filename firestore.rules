 match /authChallenges/{id}{allow read,write:if false;}
 match /authRateLimits/{id}{allow read,write:if false;}
 match /safetyEvents/{id}{
   function safetyOrder(){return get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data;}
   function validSafetyPoint(){return (request.resource.data.latitude==null&&request.resource.data.longitude==null)||(request.resource.data.latitude is number&&request.resource.data.latitude>=-90&&request.resource.data.latitude<=90&&request.resource.data.longitude is number&&request.resource.data.longitude>=-180&&request.resource.data.longitude<=180);}
   allow read:if admin()||(signed()&&(resource.data.reportedBy==request.auth.uid));
   allow create:if signed()
     && request.resource.data.keys().hasOnly(['orderId','reportedBy','reporterRole','kind','latitude','longitude','note','createdAt'])
     && request.resource.data.reportedBy==request.auth.uid
     && request.resource.data.reporterRole in ['customer','driver']
     && request.resource.data.kind in ['sos','driver_sos']
     && request.resource.data.note is string && request.resource.data.note.size()<=300
     && request.resource.data.createdAt==request.time
     && validSafetyPoint()
     && ((request.resource.data.reporterRole=='customer'&&safetyOrder().userId==request.auth.uid)||(request.resource.data.reporterRole=='driver'&&safetyOrder().driverId==request.auth.uid));
   allow update,delete:if admin();
 }

 match /serviceApplications/{uid}{
   function validApplication(data){return data.userId==uid
     && data.ownerName is string && data.ownerName.size()>=2 && data.ownerName.size()<=80
     && data.businessName is string && data.businessName.size()>=2 && data.businessName.size()<=80
     && validServiceCategory(data.category)
     && data.phone is string && data.phone.size()>=8 && data.phone.size()<=20
     && data.email is string && data.email.size()>=3 && data.email.size()<=160
     && data.city is string && data.city.size()>=2 && data.city.size()<=50
     && data.address is string && data.address.size()>=3 && data.address.size()<=160
     && data.location is map
     && data.location.latitude is number && data.location.latitude>=-90 && data.location.latitude<=90
     && data.location.longitude is number && data.location.longitude>=-180 && data.location.longitude<=180
     && data.get('description','') is string && data.get('description','').size()<=500
     && data.serviceType=='other';}
   allow create:if own(uid)
     && getAfter(/databases/$(database)/documents/users/$(uid)).data.get('role',null)=='serviceApplicant'
     && request.resource.data.status=='pending'
     && validApplication(request.resource.data)
     && request.resource.data.keys().hasOnly(['userId','ownerName','businessName','category','serviceType','phone','email','city','address','location','description','status','reviewNote','submittedAt','updatedAt']);
   allow read:if own(uid)||admin();
   allow update:if admin()||(own(uid)
     && serviceApplicant()
     && resource.data.status!='approved'
     && request.resource.data.status=='pending'
     && validApplication(request.resource.data)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName','businessName','category','phone','email','city','address','location','description','status','reviewNote','resubmittedAt','updatedAt']));
   allow delete:if admin();
 }

 match /serviceProfiles/{uid}{
   function validProfile(data){return data.ownerId==uid
     && data.businessName is string && data.businessName.size()>=2 && data.businessName.size()<=80
     && validServiceCategory(data.category)
     && data.phone is string && data.phone.size()>=8 && data.phone.size()<=20
     && data.city is string && data.city.size()<=50
     && data.address is string && data.address.size()>=3 && data.address.size()<=160
     && data.location is map
     && data.location.latitude is number && data.location.latitude>=-90 && data.location.latitude<=90
     && data.location.longitude is number && data.location.longitude>=-180 && data.location.longitude<=180
     && data.get('description','') is string && data.get('description','').size()<=500
     && data.get('items',[]) is list && data.get('items',[]).size()<=50
     && data.active is bool
     && data.approvalStatus=='approved';}
   allow read:if admin()||own(uid)||(signed()&&resource.data.active==true&&resource.data.approvalStatus=='approved');
   function validPublishPayment(){let was=resource.data.get('publishFeePaid',false);let now=request.resource.data.get('publishFeePaid',false);return was?(now==true&&request.resource.data.get('publishFeeAmount',0)==resource.data.get('publishFeeAmount',0)):(!request.resource.data.active?(now==false&&request.resource.data.get('publishFeeAmount',0)==0):(now==true&&request.resource.data.publishFeeAmount==publishFee()&&request.resource.data.publishFeePaidAt is timestamp&&walletCharged(uid,publishFee())));}
   allow create:if admin()||(own(uid)&&serviceProvider()&&validProfile(request.resource.data)&&request.resource.data.get('publishFeePaid',false)==true&&request.resource.data.get('publishFeeAmount',0)==publishFee()&&walletCharged(uid,publishFee()));
   allow update:if admin()||(own(uid)
     && serviceProvider()
     && validProfile(request.resource.data)
     && request.resource.data.ownerId==resource.data.ownerId
     && request.resource.data.category==resource.data.category
     && request.resource.data.approvalStatus==resource.data.approvalStatus
     && validPublishPayment()
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['businessName','phone','city','address','description','location','items','coverImageUrl','coverImagePath','coverImageBytes','active','publishFeePaid','publishFeeAmount','publishFeePaidAt','updatedAt']));
   allow delete:if admin();
 }

 match /serviceRequests/{id}{
   function providerProfile(){return get(/databases/$(database)/documents/serviceProfiles/$(request.resource.data.providerId)).data;}
   function providerItem(){return providerProfile().items[request.resource.data.itemIndex];}
   function deliveryOrderAfter(){return getAfter(/databases/$(database)/documents/orders/$(request.resource.data.deliveryOrderId)).data;}
   function cartItems(){return request.resource.data.items;}
   function cartLine(i){return cartItems()[i];}
   function catalogLine(i){return providerProfile().items[cartLine(i).itemIndex];}
   function cartLineValid(i){
     let line=cartLine(i); let item=catalogLine(i);
     return line.keys().hasOnly(['itemIndex','itemName','itemUnit','quantity','unitPrice','subtotal','deliveryAvailable','deliveryFee'])
       && line.itemIndex is int && line.itemIndex>=0 && line.itemIndex<providerProfile().items.size()
       && line.itemName==item.name
       && line.itemUnit==item.get('unit','item')
       && line.unitPrice is number && line.unitPrice>0 && line.unitPrice==item.price
       && line.quantity is number && line.quantity>0 && line.quantity<=100
       && ((line.itemUnit in ['kg','liter','meter','hour'])||line.quantity is int)
       && line.subtotal==line.unitPrice*line.quantity
       && line.deliveryAvailable==item.get('deliveryAvailable',false)
       && line.deliveryFee is number && line.deliveryFee>=0
       && ((!line.deliveryAvailable&&line.deliveryFee==0)||(line.deliveryAvailable&&line.deliveryFee==item.get('deliveryFee',0)));
   }
   function cartValid(){
     let n=cartItems().size();
     return n>=1&&n<=8&&cartLineValid(0)
       &&(n<2||cartLineValid(1))&&(n<3||cartLineValid(2))&&(n<4||cartLineValid(3))&&(n<5||cartLineValid(4))
       &&(n<6||cartLineValid(5))&&(n<7||cartLineValid(6))&&(n<8||cartLineValid(7));
   }
   function cartSubtotal(){
     let n=cartItems().size();
     return cartLine(0).subtotal+(n>1?cartLine(1).subtotal:0)+(n>2?cartLine(2).subtotal:0)+(n>3?cartLine(3).subtotal:0)
       +(n>4?cartLine(4).subtotal:0)+(n>5?cartLine(5).subtotal:0)+(n>6?cartLine(6).subtotal:0)+(n>7?cartLine(7).subtotal:0);
   }
   function cartAllDeliverable(){
     let n=cartItems().size();
     return cartLine(0).deliveryAvailable&&(n<2||cartLine(1).deliveryAvailable)&&(n<3||cartLine(2).deliveryAvailable)&&(n<4||cartLine(3).deliveryAvailable)
       &&(n<5||cartLine(4).deliveryAvailable)&&(n<6||cartLine(5).deliveryAvailable)&&(n<7||cartLine(6).deliveryAvailable)&&(n<8||cartLine(7).deliveryAvailable);
   }
   function cartDeliveryFeeIsMax(value){
     let n=cartItems().size();
     return value>=cartLine(0).deliveryFee&&(n<2||value>=cartLine(1).deliveryFee)&&(n<3||value>=cartLine(2).deliveryFee)&&(n<4||value>=cartLine(3).deliveryFee)
       &&(n<5||value>=cartLine(4).deliveryFee)&&(n<6||value>=cartLine(5).deliveryFee)&&(n<7||value>=cartLine(6).deliveryFee)&&(n<8||value>=cartLine(7).deliveryFee)
       &&(value==cartLine(0).deliveryFee||(n>1&&value==cartLine(1).deliveryFee)||(n>2&&value==cartLine(2).deliveryFee)||(n>3&&value==cartLine(3).deliveryFee)
          ||(n>4&&value==cartLine(4).deliveryFee)||(n>5&&value==cartLine(5).deliveryFee)||(n>6&&value==cartLine(6).deliveryFee)||(n>7&&value==cartLine(7).deliveryFee));
   }
   function leadMatchesCart(){return request.resource.data.itemCount==cartItems().size()&&request.resource.data.itemIndex==cartLine(0).itemIndex&&request.resource.data.itemName==cartLine(0).itemName&&request.resource.data.itemUnit==cartLine(0).itemUnit&&request.resource.data.quantity==cartLine(0).quantity&&request.resource.data.unitPrice==cartLine(0).unitPrice&&request.resource.data.itemPrice==cartLine(0).unitPrice;}

   // Phase 72: طلب متعدد الأصناف من نفس المطعم.
   allow create:if customer()
     && request.resource.data.providerCategory=='restaurant'
     && request.resource.data.customerId==request.auth.uid
     && request.resource.data.customerName==userDoc().get('name','')
     && request.resource.data.providerId is string && request.resource.data.providerId.size()>0
     && providerProfile().active==true && providerProfile().approvalStatus=='approved'
     && request.resource.data.providerName==providerProfile().businessName
     && request.resource.data.providerCity==providerProfile().city
     && request.resource.data.providerAddress==providerProfile().address
     && request.resource.data.providerLocation==providerProfile().location
     && request.resource.data.status=='pending'
     && request.resource.data.items is list && cartValid() && leadMatchesCart()
     && request.resource.data.subtotal==cartSubtotal()
     && request.resource.data.deliveryRequested is bool
