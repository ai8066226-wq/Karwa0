       || (resource.data.driverId==request.auth.uid && request.resource.data.driverId==request.auth.uid && resource.data.cancelled==false && request.resource.data.cancelled==false && resource.data.type=='serviceDelivery' && resource.data.statusIndex==2 && request.resource.data.statusIndex==3 && pickupOtpMatches() && request.resource.data.pickupVerifiedAt is timestamp && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusIndex','startedAt','pickupVerificationCode','pickupVerifiedAt','updatedAt']))
