rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function signed(){return request.auth!=null;}
 function own(id){return signed()&&request.auth.uid==id;}
 function userDoc(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
 function userExists(){return signed()&&exists(/databases/$(database)/documents/users/$(request.auth.uid));}
 function role(){return userExists()?userDoc().get('role',null):null;}
 function admin(){return signed()&&role()=='admin';}
 function driver(){return signed()&&role()=='driver';}
 function customer(){return signed()&&role()=='customer';}
 function serviceApplicant(){return signed()&&role()=='serviceApplicant';}
 function serviceProvider(){return signed()&&role()=='serviceProvider';}
 function roadDriverDoc(){return get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data;}
 function driverNearRoadReport(reportData){
   let d=roadDriverDoc();
   return driver()
     && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
     && d.get('blocked',false)!=true
     && d.latitude is number && d.longitude is number
     && d.get('locationAccuracy',9999) is number && d.get('locationAccuracy',9999)<=45
     && d.get('locationUpdatedAt',null) is timestamp
     && d.locationUpdatedAt>request.time-duration.value(2,'m')
     && reportData.latitude is number && reportData.longitude is number
     && ((reportData.latitude-d.latitude)*111.32)*((reportData.latitude-d.latitude)*111.32)
       +((reportData.longitude-d.longitude)*(d.latitude>=35?90:(d.latitude>=33?92:(d.latitude>=31?94.5:97))))*((reportData.longitude-d.longitude)*(d.latitude>=35?90:(d.latitude>=33?92:(d.latitude>=31?94.5:97))))<=0.0144;
 }
 function validServiceCategory(value){return value in ['restaurant','grocery','retail','maintenance','home','health','other'];}
 function validDriverApplication(data){return data.serviceType in ['taxi','delivery','other']&&((data.serviceType=='taxi'&&data.vehicleType!='دراجة')||data.serviceType=='delivery'||data.serviceType=='other');}
 function pricingExists(){return exists(/databases/$(database)/documents/appSettings/pricing);}
 function pricing(){return get(/databases/$(database)/documents/appSettings/pricing).data;}
 function customerOrderFee(){return pricingExists()?pricing().get('customerOrderFee',250):250;}
 function customerTaxiFee(){return pricingExists()?pricing().get('customerTaxiFee',pricing().get('customerOrderFee',250)):250;}
 function customerDeliveryFee(){return pricingExists()?pricing().get('customerDeliveryFee',pricing().get('customerOrderFee',250)):250;}
 function customerServiceFee(){return pricingExists()?pricing().get('customerServiceFee',pricing().get('customerOrderFee',250)):250;}
 function providerOrderFee(){return pricingExists()?pricing().get('providerOrderFee',250):250;}
 function providerRestaurantFee(){return pricingExists()?pricing().get('providerRestaurantFee',pricing().get('providerOrderFee',250)):250;}
 function providerServiceFee(){return pricingExists()?pricing().get('providerServiceFee',pricing().get('providerOrderFee',250)):250;}
 function captainOrderFee(){return pricingExists()?pricing().get('captainOrderFee',250):250;}
 function captainTaxiFee(){return pricingExists()?pricing().get('captainTaxiFee',pricing().get('captainOrderFee',250)):250;}
 function captainDeliveryFee(){return pricingExists()?pricing().get('captainDeliveryFee',pricing().get('captainOrderFee',250)):250;}
 function customerFeeForOrder(data){return data.type=='ride'?customerTaxiFee():customerDeliveryFee();}
 function captainFeeForOrder(data){return data.type=='ride'?captainTaxiFee():captainDeliveryFee();}
 function providerFeeForRequest(data){return data.providerCategory=='restaurant'?providerRestaurantFee():providerServiceFee();}
 function publishFee(){return pricingExists()?pricing().get('publishFee',1000):1000;}
 function signupBonusEnabled(){return !pricingExists()||pricing().get('signupBonusEnabled',true)==true;}
 function signupBonusAmount(){return pricingExists()?pricing().get('signupBonusAmount',1000):1000;}
 function signupBonusHours(){return pricingExists()?pricing().get('signupBonusHours',24):24;}
 function walletValue(data){return data.get('balance',0)+(data.get('bonusBalance',0)>0&&data.get('bonusExpiresAt',request.time)>request.time?data.get('bonusBalance',0):0);}
 function walletCharged(uid,amount){let before=get(/databases/$(database)/documents/users/$(uid)).data;let after=getAfter(/databases/$(database)/documents/users/$(uid)).data;return amount==0||(walletValue(before)>=amount&&walletValue(after)==walletValue(before)-amount&&after.get('balance',0)>=0&&after.get('bonusBalance',0)>=0);}
 function validSignupWallet(data){let b=data.get('bonusBalance',0);return data.balance==0&&data.get('welcomeBonusEvaluated',false)==true&&(signupBonusEnabled()?(b==signupBonusAmount()&&b>=0&&((b==0&&data.get('bonusExpiresAt',null)==null)||(b>0&&data.bonusExpiresAt is timestamp&&data.bonusExpiresAt>request.time&&data.bonusExpiresAt<=request.time+duration.value(signupBonusHours(),'h')))&&data.get('welcomeBonusGranted',false)==(b>0)):(b==0&&data.get('welcomeBonusGranted',false)==false));}
 function walletDecreaseOnly(){return request.resource.data.get('balance',0) is number&&request.resource.data.get('bonusBalance',0) is number&&request.resource.data.get('balance',0)>=0&&request.resource.data.get('bonusBalance',0)>=0&&request.resource.data.get('balance',0)<=resource.data.get('balance',0)&&request.resource.data.get('bonusBalance',0)<=resource.data.get('bonusBalance',0)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance','bonusBalance','updatedAt']);}
 function validAdminActivationUser(data){return admin()
   && data.role in ['driver','serviceProvider']
   && data.balance is number && data.balance>=0
   && data.get('bonusBalance',0) is number && data.get('bonusBalance',0)>=0
   && data.get('notifications',true) is bool;}
 function validDeviceKey(value){return value is string&&value.matches('^KDW1-[A-F0-9]{64}$');}
 function validDeviceRoleFamily(value){return value in ['customer','driver','service'];}
 function signupDeviceBound(uid){
   let link=getAfter(/databases/$(database)/documents/accountDeviceLinks/$(uid)).data;
   let binding=getAfter(/databases/$(database)/documents/deviceBindings/$(link.deviceKey)).data;
   let access=getAfter(/databases/$(database)/documents/deviceAccess/$(uid)/devices/$(link.deviceKey)).data;
   return validDeviceKey(link.deviceKey)
     && link.userId==uid
     && binding.deviceKey==link.deviceKey
     && binding.userId==uid
     && binding.status=='active'
     && access.active==true;
 }
 function legacyDeviceBindUpgrade(uid){return own(uid)
   && resource.data.get('deviceBound',false)!=true
   && request.resource.data.deviceBound==true
   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceBound','updatedAt'])
   && signupDeviceBound(uid);}
 match /users/{uid}{
   allow create:if (own(uid)
     && (request.resource.data.role=='customer'||request.resource.data.role=='driverApplicant'||request.resource.data.role=='serviceApplicant')
     && request.resource.data.balance is number
     && request.resource.data.deviceBound==true
     && signupDeviceBound(uid)
     && validSignupWallet(request.resource.data))
     || validAdminActivationUser(request.resource.data);
   allow read:if own(uid)||admin();
   allow update:if admin()||legacyDeviceBindUpgrade(uid)||(own(uid)&&(
     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','notifications','savedAddresses','updatedAt']))
     || walletDecreaseOnly()
     || (!resource.data.keys().hasAny(['referralCode'])
       && request.resource.data.referralCode is string
       && request.resource.data.referralCode.size()>=6 && request.resource.data.referralCode.size()<=24
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralCode','updatedAt']))
     || (!resource.data.keys().hasAny(['role'])
       && request.resource.data.role=='customer'
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','email','updatedAt']))
   ));
   allow delete:if admin();
   match /pushTokens/{id}{allow read:if own(uid)||admin();allow write:if own(uid);}
 }
 match /deviceBindings/{deviceKey}{
   allow read:if admin();
   allow create:if signed()
     && validDeviceKey(deviceKey)
     && request.resource.data.keys().hasOnly(['deviceKey','userId','roleFamily','status','deviceLabel','boundAt','updatedAt'])
     && request.resource.data.deviceKey==deviceKey
     && request.resource.data.userId==request.auth.uid
     && validDeviceRoleFamily(request.resource.data.roleFamily)
     && request.resource.data.status=='active'
     && request.resource.data.deviceLabel is string && request.resource.data.deviceLabel.size()<=120
     && request.resource.data.boundAt is timestamp && request.resource.data.updatedAt is timestamp
     && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.deviceBound==true
     && getAfter(/databases/$(database)/documents/accountDeviceLinks/$(request.auth.uid)).data.deviceKey==deviceKey
     && getAfter(/databases/$(database)/documents/deviceAccess/$(request.auth.uid)/devices/$(deviceKey)).data.active==true;
   allow update,delete:if admin();
 }
 match /accountDeviceLinks/{uid}{
   allow read:if admin();
   allow create:if own(uid)
     && request.resource.data.keys().hasOnly(['userId','deviceKey','roleFamily','deviceLabel','boundAt','updatedAt'])
     && request.resource.data.userId==uid
     && validDeviceKey(request.resource.data.deviceKey)
     && validDeviceRoleFamily(request.resource.data.roleFamily)
     && request.resource.data.deviceLabel is string && request.resource.data.deviceLabel.size()<=120
     && request.resource.data.boundAt is timestamp && request.resource.data.updatedAt is timestamp
     && getAfter(/databases/$(database)/documents/deviceBindings/$(request.resource.data.deviceKey)).data.userId==uid
     && getAfter(/databases/$(database)/documents/deviceBindings/$(request.resource.data.deviceKey)).data.status=='active'
     && getAfter(/databases/$(database)/documents/deviceAccess/$(uid)/devices/$(request.resource.data.deviceKey)).data.active==true;
   allow update,delete:if admin();
 }
 match /deviceAccess/{uid}/devices/{deviceKey}{
   allow get:if admin()||own(uid);
   allow list:if admin();
   allow create:if own(uid)
     && validDeviceKey(deviceKey)
     && request.resource.data.keys().hasOnly(['active','boundAt','updatedAt'])
     && request.resource.data.active==true
     && request.resource.data.boundAt is timestamp && request.resource.data.updatedAt is timestamp
     && getAfter(/databases/$(database)/documents/deviceBindings/$(deviceKey)).data.userId==uid
     && getAfter(/databases/$(database)/documents/deviceBindings/$(deviceKey)).data.status=='active'
     && getAfter(/databases/$(database)/documents/accountDeviceLinks/$(uid)).data.deviceKey==deviceKey;
   allow update,delete:if admin();
 }
 match /deviceChangeRequests/{uid}{
   function deviceFreeForReplacement(){return !exists(/databases/$(database)/documents/deviceBindings/$(request.resource.data.newDeviceKey))
     || (get(/databases/$(database)/documents/deviceBindings/$(request.resource.data.newDeviceKey)).data.userId==uid
       && get(/databases/$(database)/documents/deviceBindings/$(request.resource.data.newDeviceKey)).data.status=='active');}
   function validOwnDeviceChange(){return own(uid)
     && get(/databases/$(database)/documents/users/$(uid)).data.get('deviceBound',false)==true
     && request.resource.data.userId==uid
     && validDeviceKey(request.resource.data.newDeviceKey)
     && request.resource.data.accountRole is string && request.resource.data.accountRole.size()<=40
     && request.resource.data.accountName is string && request.resource.data.accountName.size()<=80
     && request.resource.data.email is string && request.resource.data.email.size()<=160
     && request.resource.data.newDeviceLabel is string && request.resource.data.newDeviceLabel.size()<=120
     && request.resource.data.status=='pending'
     && request.resource.data.requestedAt is timestamp && request.resource.data.updatedAt is timestamp
     && deviceFreeForReplacement();}
   allow read:if admin();
   allow create:if validOwnDeviceChange()
     && request.resource.data.keys().hasOnly(['userId','accountRole','accountName','email','newDeviceKey','newDeviceLabel','status','requestedAt','updatedAt']);
   allow update:if admin()||(validOwnDeviceChange()
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountRole','accountName','email','newDeviceKey','newDeviceLabel','status','requestedAt','updatedAt']));
   allow delete:if admin();
 }
 match /driverApplications/{uid}{allow create:if own(uid)&&request.resource.data.userId==request.auth.uid&&request.resource.data.status=='pending'&&validDriverApplication(request.resource.data);allow read:if own(uid)||admin();allow update:if admin()||(own(uid)&&resource.data.status!='approved'&&request.resource.data.userId==request.auth.uid&&request.resource.data.status=='pending'&&validDriverApplication(request.resource.data)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','phone','serviceType','vehicleType','vehicleMake','vehicleModel','vehicleCondition','plate','city','status','profileComplete','submittedAt','updatedAt']));allow delete:if admin();}
 match /drivers/{uid}{
   allow read:if admin()||driver()||own(uid);
   allow create,delete:if admin();
   allow update:if admin()||(own(uid)&&driver()&&(
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online','latitude','longitude','locationAccuracy','locationUpdatedAt','updatedAt'])
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['markerStyle','updatedAt'])
       && request.resource.data.markerStyle in ['arrow','car','bike'])
     )
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeOrderId','activeOrderCode','busySince','updatedAt'])&&(
       (resource.data.get('activeOrderId','')==''
         && request.resource.data.activeOrderId is string
         && request.resource.data.activeOrderId.size()>0
         && request.resource.data.activeOrderCode is string
         && request.resource.data.busySince is timestamp
         && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.activeOrderId)).data.driverId==uid
         && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.activeOrderId)).data.cancelled==false
         && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.activeOrderId)).data.statusIndex<4)
       || (resource.data.get('activeOrderId','')!=''
         && request.resource.data.activeOrderId==''
         && request.resource.data.activeOrderCode==''
         && request.resource.data.busySince==null
         && (getAfter(/databases/$(database)/documents/orders/$(resource.data.activeOrderId)).data.cancelled==true
           || getAfter(/databases/$(database)/documents/orders/$(resource.data.activeOrderId)).data.statusIndex>=4))
     ))
   ));
 }
 match /publicDrivers/{uid}{
   function privateDriver(){return get(/databases/$(database)/documents/drivers/$(uid)).data;}
   allow read:if signed();
   allow create,update:if own(uid)&&driver()
     && exists(/databases/$(database)/documents/drivers/$(uid))
     && privateDriver().get('blocked',false)!=true
     && request.resource.data.keys().hasOnly(['driverId','name','vehicleType','online','latitude','longitude','locationAccuracy','locationUpdatedAt','updatedAt'])
     && request.resource.data.driverId==uid
     && request.resource.data.name is string
     && request.resource.data.name==userDoc().get('name','')
     && request.resource.data.name.size()>=2
     && request.resource.data.name.size()<=80
     && request.resource.data.vehicleType is string
     && request.resource.data.vehicleType==privateDriver().get('vehicleType','مركبة')
     && request.resource.data.online==true
     && request.resource.data.latitude is number
     && request.resource.data.latitude>=-90
     && request.resource.data.latitude<=90
     && request.resource.data.longitude is number
     && request.resource.data.longitude>=-180
     && request.resource.data.longitude<=180
     && request.resource.data.locationAccuracy is number
     && request.resource.data.locationAccuracy>=0
     && request.resource.data.locationUpdatedAt is timestamp
     && request.resource.data.updatedAt is timestamp;
   allow delete:if admin()||(own(uid)&&driver());
 }
 match /orders/{id}{
   function linkedServiceRequest(){return getAfter(/databases/$(database)/documents/serviceRequests/$(request.resource.data.serviceRequestId)).data;}
   function validOrderMoney(data){return data.commissionRate==0&&data.commissionAmount==0&&data.driverEarnings==data.price&&data.customerPlatformFee is number&&data.customerPlatformFee>=0&&data.captainPlatformFee is number&&data.captainPlatformFee>=0&&data.captainFeeCharged==false;}
   function currentDriver(){return get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data;}
   function pickupOtpMatches(){
     return resource.data.type=='serviceDelivery'
       && resource.data.serviceRequestId is string
       && resource.data.serviceRequestId.size()>0
       && request.resource.data.pickupVerificationCode is string
       && request.resource.data.pickupVerificationCode.matches('^[0-9]{4}$')
       && exists(/databases/$(database)/documents/serviceRequests/$(resource.data.serviceRequestId))
       && get(/databases/$(database)/documents/serviceRequests/$(resource.data.serviceRequestId)).data.providerId==resource.data.providerId
       && get(/databases/$(database)/documents/serviceRequests/$(resource.data.serviceRequestId)).data.get('pickupOtp','')==request.resource.data.pickupVerificationCode;
   }
   // حماية إضافية عند قبول الطلب: موقع الكابتن المسجل يجب أن يكون قريبًا من نقطة بداية الطلب.
   // الواجهة تطبق Haversine بدقة 10 كم؛ هذه الدالة تمنع تجاوزًا مباشرًا من عميل معدل.
   function driverNearPickup10Km(){
     let d=currentDriver();
     let p=resource.data.pickupLocation;
     let dLat=(p.latitude-d.latitude)*111.32;
     let lonFactor=d.latitude>=35?90:(d.latitude>=33?92:(d.latitude>=31?94.5:97));
     let dLon=(p.longitude-d.longitude)*lonFactor;
     return p is map
       && p.latitude is number && p.longitude is number
       && d.latitude is number && d.longitude is number
       && dLat*dLat+dLon*dLon<=100;
   }
   function autoDriverTracking(){return get(/databases/$(database)/documents/orders/$(id)/tracking/current).data;}
   function autoCustomerTracking(){return get(/databases/$(database)/documents/orders/$(id)/customerTracking/current).data;}
   function autoTrackingFresh(point){return point.get('accuracy',9999) is number&&point.get('accuracy',9999)<=45&&point.get('updatedAt',null) is timestamp&&point.updatedAt>request.time-duration.value(75,'s');}
   function autoNearDestination(point){
     let p=resource.data.destinationLocation;
     let latKm=(point.latitude-p.latitude)*111.32;
     let lonFactor=p.latitude>=35?90:(p.latitude>=33?92:(p.latitude>=31?94.5:97));
     let lonKm=(point.longitude-p.longitude)*lonFactor;
     return p is map&&p.latitude is number&&p.longitude is number&&point.latitude is number&&point.longitude is number&&latKm*latKm+lonKm*lonKm<=0.0144;
   }
   function autoPairNear(customerPoint,driverPoint){
     let latKm=(customerPoint.latitude-driverPoint.latitude)*111.32;
     let lonFactor=driverPoint.latitude>=35?90:(driverPoint.latitude>=33?92:(driverPoint.latitude>=31?94.5:97));
     let lonKm=(customerPoint.longitude-driverPoint.longitude)*lonFactor;
     return latKm*latKm+lonKm*lonKm<=0.0324;
   }
   function gpsAutoCompleteAllowed(){
     let d=autoDriverTracking();
     let c=autoCustomerTracking();
     return signed()
       && resource.data.type=='ride'
       && resource.data.cancelled==false
       && resource.data.statusIndex==2
       && resource.data.driverId is string && resource.data.driverId.size()>0
       && ((customer()&&request.auth.uid==resource.data.userId)||(driver()&&request.auth.uid==resource.data.driverId))
       && resource.data.get('customerFeeCharged',false)==true
       && resource.data.get('captainFeeCharged',false)==true
       && d.driverId==resource.data.driverId
       && c.customerId==resource.data.userId
       && autoTrackingFresh(d) && autoTrackingFresh(c)
       && autoNearDestination(d) && autoNearDestination(c) && autoPairNear(c,d)
       && request.resource.data.driverId==resource.data.driverId
       && request.resource.data.userId==resource.data.userId
       && request.resource.data.statusIndex==4
       && request.resource.data.completedAt is timestamp
       && request.resource.data.startedAt is timestamp
       && request.resource.data.paymentStatus=='paid'
       && request.resource.data.autoCompletedByGPS==true
       && request.resource.data.autoCompletionReason=='both_near_destination_without_otp'
       && request.resource.data.autoCompletedAt is timestamp
       && request.resource.data.autoCompletionActor==request.auth.uid
       && request.resource.data.autoArrivalRadiusM==120
       && request.resource.data.otpBypassed==true
       && request.resource.data.customerFeeCharged==true
       && request.resource.data.captainFeeCharged==true
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusIndex','startedAt','completedAt','paymentStatus','autoCompletedByGPS','autoCompletionReason','autoCompletedAt','autoCompletionActor','autoArrivalRadiusM','otpBypassed','updatedAt']);
   }
   function taxiOrderVisible(){return driver()&&currentDriver().get('serviceType','')=='taxi'&&currentDriver().get('vehicleType','')!='دراجة'&&resource.data.type=='ride';}
   function deliveryOrderVisible(){return driver()&&currentDriver().get('serviceType','')=='delivery'&&currentDriver().get('vehicleType','') in ['اقتصادي','تكسي','عائلي','دراجة']&&resource.data.type in ['parcel','food','serviceDelivery'];}
   allow read:if signed()&&(resource.data.userId==request.auth.uid||resource.data.driverId==request.auth.uid||taxiOrderVisible()||deliveryOrderVisible()||admin()||(serviceProvider()&&resource.data.get('providerId','')==request.auth.uid));
   allow create:if admin()
     || (customer()
       && request.resource.data.userId==request.auth.uid
       && request.resource.data.type!='serviceDelivery'
       && request.resource.data.driverId==null
       && request.resource.data.statusIndex==0
       && request.resource.data.cancelled==false
       && validOrderMoney(request.resource.data)
       && request.resource.data.customerPlatformFee==customerFeeForOrder(request.resource.data)
       && request.resource.data.customerFeeCharged==true
       && walletCharged(request.auth.uid,customerFeeForOrder(request.resource.data)))
     || (customer()
       && request.resource.data.type=='serviceDelivery'
       && request.resource.data.userId==request.auth.uid
       && request.resource.data.providerId is string
       && request.resource.data.serviceRequestId is string
       && request.resource.data.serviceRequestId.size()>0
       && request.resource.data.driverId==null
       && request.resource.data.statusIndex==0
       && request.resource.data.cancelled==false
       && request.resource.data.requiredDriverService=='delivery'
       && request.resource.data.payment=='نقدًا'
       && validOrderMoney(request.resource.data)
       && request.resource.data.customerPlatformFee==0
       && request.resource.data.customerFeeCharged==true
       && linkedServiceRequest().customerId==request.auth.uid
       && linkedServiceRequest().providerId==request.resource.data.providerId
       && linkedServiceRequest().status=='accepted'
       && linkedServiceRequest().deliveryRequested==true
       && linkedServiceRequest().deliveryStatus=='awaitingCaptain'
       && linkedServiceRequest().deliveryOrderId==id
       && linkedServiceRequest().providerCity==request.resource.data.serviceCity
       && linkedServiceRequest().providerLocation==request.resource.data.pickupLocation
       && linkedServiceRequest().customerLocation==request.resource.data.destinationLocation
       && linkedServiceRequest().totalPrice==request.resource.data.serviceTotal
       && linkedServiceRequest().deliveryFee==request.resource.data.price)
     || (serviceProvider()
       && request.resource.data.type=='serviceDelivery'
       && request.resource.data.providerId==request.auth.uid
       && request.resource.data.serviceRequestId is string
       && request.resource.data.serviceRequestId.size()>0
       && request.resource.data.driverId==null
       && request.resource.data.statusIndex==0
       && request.resource.data.cancelled==false
       && request.resource.data.requiredDriverService=='delivery'
       && request.resource.data.payment=='نقدًا'
       && validOrderMoney(request.resource.data)
       && request.resource.data.customerPlatformFee==0
       && request.resource.data.customerFeeCharged==true
       && linkedServiceRequest().providerCategory=='restaurant'
       && linkedServiceRequest().providerId==request.auth.uid
       && linkedServiceRequest().customerId==request.resource.data.userId
       && linkedServiceRequest().status=='accepted'
       && linkedServiceRequest().deliveryRequested==true
       && linkedServiceRequest().deliveryStatus=='awaitingCaptain'
       && linkedServiceRequest().deliveryOrderId==id
       && linkedServiceRequest().providerCity==request.resource.data.serviceCity
       && linkedServiceRequest().providerLocation==request.resource.data.pickupLocation
       && linkedServiceRequest().customerLocation==request.resource.data.destinationLocation
       && linkedServiceRequest().totalPrice==request.resource.data.serviceTotal
       && linkedServiceRequest().deliveryFee==request.resource.data.price);
   allow update:if admin()
     || (customer()
       && resource.data.type=='parcel'
       && resource.data.userId==request.auth.uid
       && resource.data.cancelled==false
       && request.resource.data.cancelled==false
       && resource.data.statusIndex<3
       && request.resource.data.statusIndex==resource.data.statusIndex
       && request.resource.data.driverId==resource.data.driverId
       && request.resource.data.title is string && request.resource.data.title.size()>=3 && request.resource.data.title.size()<=120
       && request.resource.data.route is string && request.resource.data.route.size()>=7 && request.resource.data.route.size()<=380
       && request.resource.data.parcelDetails is map
       && request.resource.data.parcelDetails.keys().hasOnly(['from','to','recipientName','recipientPhone','notes'])
