rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function own(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }

    function isDriver() {
      return signedIn() && userRole() == 'driver';
    }

    function isCustomer() {
      return signedIn() && userRole() == 'customer';
    }

    function isActiveDriver() {
      return isDriver()
             && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.get('blocked', false) == false;
    }

    match /users/{userId} {
      allow create: if own(userId)
                    && request.resource.data.role == 'customer';

      allow read: if own(userId) || isAdmin();

      allow update: if isAdmin()
                    || (own(userId)
                        && isCustomer()
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['name', 'email', 'notifications', 'balance', 'updatedAt']))
                    || (own(userId)
                        && !('role' in resource.data)
                        && request.resource.data.role == 'customer'
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['name', 'email', 'notifications', 'balance', 'role', 'updatedAt']));

      allow delete: if isAdmin();
    }

    match /driverApplications/{userId} {
      allow create: if own(userId)
                    && request.resource.data.userId == request.auth.uid
                    && isCustomer()
                    && request.resource.data.status == 'pending';

      allow read: if own(userId) || isAdmin();

      allow update: if isAdmin()
                    || (own(userId)
                        && isCustomer()
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.status == 'pending'
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['name', 'email', 'phone', 'vehicleType', 'plate', 'city', 'status', 'submittedAt', 'updatedAt']));

      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow create, delete: if isAdmin();
      allow read: if own(driverId) || isAdmin();
      allow update: if isAdmin()
                    || (own(driverId)
                        && isActiveDriver()
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['online', 'updatedAt']));
    }

    match /orders/{orderId} {
      allow create: if isCustomer()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.driverId == null
                    && request.resource.data.statusIndex == 0
                    && request.resource.data.cancelled == false;

      allow read: if signedIn()
                  && (resource.data.userId == request.auth.uid || isDriver() || isAdmin());

      allow update: if (isAdmin())
                    || (isCustomer()
                        && resource.data.userId == request.auth.uid
                        && resource.data.cancelled == false
                        && resource.data.statusIndex < 3
                        && request.resource.data.cancelled == true
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['cancelled','cancelledBy','cancellationReason','updatedAt']))
                    || (isActiveDriver()
                        && (!('driverId' in resource.data) || resource.data.driverId == null)
                        && request.resource.data.driverId == request.auth.uid
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.statusIndex == 1
                        && request.resource.data.assignmentStatus == 'accepted'
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['driverId','driverName','driverPhone','assignmentStatus','statusIndex','acceptedAt','updatedAt']))
                    || (isActiveDriver()
                        && resource.data.driverId == request.auth.uid
                        && request.resource.data.driverId == request.auth.uid
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.statusIndex == resource.data.statusIndex + 1
                        && request.resource.data.statusIndex <= 4
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['statusIndex','assignmentStatus','arrivedAt','startedAt','completedAt','paymentStatus','updatedAt']));

      allow delete: if isAdmin();
    }

    match /orders/{orderId}/tracking/{trackingId} {
      function parentOrder() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }

      allow read: if signedIn()
                  && (parentOrder().userId == request.auth.uid
                      || parentOrder().driverId == request.auth.uid
                      || isAdmin());

      allow create, update: if isActiveDriver()
                            && parentOrder().driverId == request.auth.uid
                            && request.resource.data.driverId == request.auth.uid
                            && request.resource.data.latitude is number
                            && request.resource.data.longitude is number
                            && request.resource.data.latitude >= -90
                            && request.resource.data.latitude <= 90
                            && request.resource.data.longitude >= -180
                            && request.resource.data.longitude <= 180
                            && request.resource.data.keys().hasOnly([
                              'driverId', 'latitude', 'longitude', 'accuracy',
                              'heading', 'speed', 'updatedAt'
                            ]);

      allow delete: if isAdmin();
    }

    match /ratings/{orderId} {
      function ratedOrder() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }

      allow create: if isCustomer()
                    && request.resource.data.keys().hasOnly([
                      'orderId', 'orderCode', 'customerId', 'driverId',
                      'driverName', 'score', 'comment', 'createdAt'
                    ])
                    && request.resource.data.orderId == orderId
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.driverId == ratedOrder().driverId
                    && ratedOrder().userId == request.auth.uid
                    && ratedOrder().cancelled == false
                    && ratedOrder().statusIndex >= 4
                    && request.resource.data.score is int
                    && request.resource.data.score >= 1
                    && request.resource.data.score <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 300;

      allow read: if signedIn()
                  && (resource.data.customerId == request.auth.uid
                      || resource.data.driverId == request.auth.uid
                      || isAdmin());

      allow delete: if isAdmin();
    }
  }
}
